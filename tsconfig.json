{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "playwright-report",
    "test-results",
    "playwright.config.ts",
    "tests",
    "scripts"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true
  }
}
