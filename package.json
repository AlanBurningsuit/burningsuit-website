{
  "name": "burningsuit-website",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "burningsuit.co.uk — Phase 2 site (Astro 6 + Tailwind v4, static, GitHub Pages)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run prep:images && astro build && npm run check:budget",
    "check:budget": "node scripts/check-budget.mjs",
    "prep:images": "node scripts/prep-images.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:seo": "node scripts/check-seo.mjs",
    "check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "serve": "http-server dist -p 4321 -s -c-1",
    "test:visual": "npm run check:tests && playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:links": "linkinator dist --recurse --silent --skip \"^mailto:|^https?://(?!localhost)\"",
    "test:lh": "lhci autorun",
    "gate": "npm run check && npm run build && npm run test:links && npm run check:seo"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/mona-sans": "^5.2.8",
    "astro": "^6.4.7",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.1.0",
    "http-server": "^14.1.1",
    "linkinator": "^7.6.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.0"
  }
}
