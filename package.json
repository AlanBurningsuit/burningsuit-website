{
  "name": "burningsuit-website",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "burningsuit website \u2014 minimal static rebuild shell",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:content && astro build && npm run check:budget",
    "preview": "astro preview",
    "check": "astro check",
    "check:brand": "node scripts/check-brand.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "prep:images": "node scripts/prep-images.mjs",
    "test:functional": "npm run check:tests && node --test tests/*.test.mjs && playwright test",
    "test:links": "linkinator dist --recurse --silent --skip \"^mailto:|^https?://(?!localhost)\"",
    "test:lh": "lhci autorun",
    "test:lh:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
    "gate": "npm run check:brand && npm run check && npm run build && npm run test:links && npm run check:seo"
  },
  "dependencies": {
    "astro": "^6.4.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "linkinator": "^7.6.1",
    "typescript": "^5.9.3",
    "yaml": "2.9.0"
  }
}
