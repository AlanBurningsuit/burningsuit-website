{
  "name": "burningsuit-website",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "The burningsuit.co.uk static site",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:content && astro build && npm run check:budget",
    "preview": "astro preview",
    "check": "astro check",
    "check:brand": "node scripts/check-brand.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:prices": "node scripts/check-prices.mjs",
    "check:prices:dist": "node scripts/check-prices.mjs --dist",
    "check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "prep:images": "node scripts/prep-images.mjs",
    "test:functional": "npm run check:tests && node --test tests/*.test.mjs && playwright test",
    "test:links": "node scripts/check-links.mjs",
    "test:lh": "lhci autorun",
    "test:lh:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
    "gate": "npm run check:brand && npm run check:copy && npm run check:prices && npm run check && npm run build && npm run check:prices:dist && npm run test:links && npm run check:seo"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "entities": "7.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "linkinator": "^7.6.1",
    "parse5": "7.3.0",
    "typescript": "^5.9.3",
    "yaml": "2.9.0"
  }
}
