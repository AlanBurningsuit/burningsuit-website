---
// Every case study in one shape: the title, the lead beside four facts, the entry's sections (and its one piece of
// evidence, where it has one), a line on what the study shows and doesn't, then the closing band back to the offer.
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TitleBand from "../components/TitleBand.astro";
import Tracked from "../components/Tracked.astro";
import { EVENTS } from "../config/analytics.mjs";
import "../styles/case-study.css";

interface Props { entry: CollectionEntry<"work"> }
const { entry } = Astro.props;
const study = entry.data;
const heading = typeof study.heading === "string" ? { before: study.heading } : study.heading;
const facts = [["Format", study.facts.format], ["Who", study.facts.who], ["Length", study.facts.length], ["Material", study.facts.material]];
const { closing } = study;
---
<BaseLayout title={study.title} description={study.description} ogImage={study.ogImage} ogType="article">
  <div class="case-study">
    <TitleBand heading={heading} />
    <div class="case-opening wrap">
      <p class="case-lead">{study.lead}</p>
      <dl class="case-facts">{facts.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
    </div>
    <slot />
    <div class="case-limits-row wrap"><p class="case-limits">{study.limits}</p></div>
    <section class="case-closing closing-band dark" aria-labelledby="closing-title">
      <div class="wrap closing-inner">
        <h2 id="closing-title">{closing.heading}</h2>
        <div class="raised-copy">
          <p>{closing.body}</p>
          {closing.link.href === "/call/"
            ? <Tracked event={EVENTS.bookCallLink}><a class="text-link" href={closing.link.href}>{closing.link.text}</a></Tracked>
            : <a class="text-link" href={closing.link.href} aria-describedby={closing.link.hint ? "closing-hint" : undefined}>{closing.link.text}</a>}
          {closing.link.hint && <p class="case-hint" id="closing-hint">{closing.link.hint}</p>}
          <p class="case-then">
            <a href={closing.then.href} aria-describedby={closing.then.hint ? "then-hint" : undefined}>{closing.then.text}</a>{" "}
            {closing.then.hint && <span class="case-hint" id="then-hint">{closing.then.hint}</span>}
          </p>
        </div>
      </div>
    </section>
    {study.namePublished && study.named && <section class="mdx-named wrap">
      <h2>{study.named.client}</h2>
      <blockquote><p>{study.named.quote}</p></blockquote>
      <p>{study.named.cite}</p>
    </section>}
  </div>
</BaseLayout>
