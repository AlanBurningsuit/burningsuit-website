---
/**
 * /work/<slug> — a single case study.
 *
 * Wraps BaseLayout with the shared case-study shell: a text-led page-hero (kicker
 * + lowercase H1 with one amber em + standfirst + an "Alan Harman-Box · burningsuit"
 * byline that mirrors the Article JSON-LD author), the chaptered MDX body via the
 * default slot, then the gated <Casefile> testimonial and a quiet door to /power-bi
 * (the considering reader's next question: shape, rhythm, price). Structure mirrors
 * /about (no hero photo — "no real screenshots" is a hard rule and these are text
 * pages). "The ask" is the footer close + the page's two contact paths (book a call
 * + email), each carrying this study's contactSubject.
 */
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Casefile from "../components/Casefile.astro";
import { articleNode, breadcrumbList } from "../lib/schema";

interface Props {
  study: CollectionEntry<"work">["data"];
}
const { study } = Astro.props;
const { kicker, heading, lead, title, description, contactSubject, footerInvitation } = study;

// Per-case-study structured data: an Article (authored by Alan, published by
// the org — both linked by @id to the site graph) plus a Home → Work → page
// BreadcrumbList. Dates flow through only when the entry carries them.
const siteUrl = Astro.site?.href ?? "https://burningsuit.co.uk/";
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const publishedTime = study.datePublished?.toISOString();
const modifiedTime = study.dateModified?.toISOString();
const article = articleNode({
  siteUrl,
  pageUrl,
  headline: [heading.before, heading.em, heading.after].filter(Boolean).join("").trim(),
  description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
});
const crumbs = breadcrumbList([
  { name: "Home", url: siteUrl },
  { name: "Work", url: `${siteUrl}work/` },
  { name: title.replace(/ - burningsuit$/, ""), url: pageUrl },
]);
---

<BaseLayout
  title={title}
  description={description}
  contactSubject={contactSubject}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={[article, crumbs]}
>
  <Fragment slot="footer-invitation">{footerInvitation}</Fragment>

  <section class="page-hero">
    <div class="wrap">
      <p class="kicker meta enter">{kicker}</p>
      <h1 class="enter appear-300">
        {heading.before}{heading.em && <em>{heading.em}</em>}{heading.after}
      </h1>
      <p class="lead enter appear-450">{lead}</p>
      <p class="meta enter appear-600">Alan Harman-Box · burningsuit</p>
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <slot />

  <Casefile study={study} />

  <section class="chapter" aria-label="working together">
    <div class="wrap">
      <div class="prose" data-reveal>
        <p>
          This is the sort of work I do embedded with a team, month to month.
          <a class="u" href="/power-bi/">what working together looks like - shape, rhythm, price ▸</a>
        </p>
      </div>
    </div>
  </section>

  <div class="thread thread-end thread-tight" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer"></div>
</BaseLayout>
