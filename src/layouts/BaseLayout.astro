---
import { Font } from "astro:assets";
import { SITE_NAME, BREADCRUMB_SECTIONS } from "../config/site";
import Schema from "../components/seo/Schema.astro";
import { siteGraph, articleNode, breadcrumbNode, type SchemaNode } from "../lib/schema";
import { ANALYTICS } from "../config/analytics.mjs";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";

interface Props {
  title?: string;
  description?: string;
  placeholder?: boolean;
  ogImage?: string;
  author?: string;
  ogType?: "website" | "article";
  /** Keeps a page out of search: the 404 and the enquiry results. Every other page is indexed. */
  noindex?: boolean;
  /** Page-specific JSON-LD nodes (a Course, the consultancy Service, About's ProfilePage), added to the identity graph. */
  schema?: SchemaNode[];
}
const {
  title = SITE_NAME,
  description = "burningsuit website rebuild.",
  placeholder = true,
  ogImage = "/og-image.png",
  author,
  ogType = "website",
  noindex: noindexProp = false,
  schema: pageNodes = [],
} = Astro.props;
// Placeholder pages never reach search either.
const noindex = noindexProp || placeholder;
const siteUrl = Astro.site!.href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageName = title.replace(/\s+[|–-]\s+burningsuit$/, "");
// Breadcrumbs only below a section page that exists (Training, Work, Privacy); other paths have no built parent.
const section = Astro.url.pathname.match(/^\/[^/]+\//)?.[0];
const crumbs = section && BREADCRUMB_SECTIONS[section] && Astro.url.pathname.replace(/\/?$/, "/") !== section
  ? [breadcrumbNode(canonical, [{ name: "Home", url: siteUrl }, { name: BREADCRUMB_SECTIONS[section], url: new URL(section, siteUrl).href }, { name: pageName, url: canonical }])]
  : [];
const graph = [
  ...siteGraph(siteUrl),
  ...(ogType === "article" ? [articleNode({ siteUrl, pageUrl: canonical, headline: pageName, description, author })] : []),
  ...pageNodes,
  ...crumbs,
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    {author && <meta name="author" content={author} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The burningsuit flame mark and wordmark" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Schema schema={graph} noindex={noindex} />
    <Font cssVariable="--font-mona" preload />
    <Font cssVariable="--font-albert" preload />
    <Font cssVariable="--font-reader" preload />
    {/* Cookieless Umami, allowed by its CSP hosts rather than a hash (is:inline keeps the external src as written). data-domains limits reporting to production; /privacy/#optout sets Umami's own opt-out flag. */}
    {ANALYTICS.enabled && (
      <script is:inline defer src={ANALYTICS.scriptSrc} data-website-id={ANALYTICS.websiteId} data-domains={ANALYTICS.domains} data-performance={ANALYTICS.performance ? "true" : undefined}></script>
    )}
  </head>
  <body id="top" data-rebuild-placeholder={placeholder || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {!placeholder && <Masthead />}
    <main id="main" tabindex="-1" class:list={{ placeholder }}><slot /></main>
    {!placeholder && <Footer />}
  </body>
</html>
