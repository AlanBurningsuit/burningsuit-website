---
/**
 * The document shell. Renders <head> (meta/OG, self-hosted <Font> tags, the
 * first-paint html.js script, the bundled enhancement module), the sticky
 * Header, the page's <main>, and the fixed basement Footer.
 *
 * The CSP <meta http-equiv> is injected automatically by Astro's `security.csp`
 * feature (it hashes the is:inline script + framework styles) — do NOT add one
 * here by hand.
 */
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { CONTACT_EMAIL, ANALYTICS } from "../config/site";
import "../styles/app.css";

interface Props {
  title: string;
  description: string;
  /** OG/twitter image, served from the site root. */
  ogImage?: string;
  /** Descriptive alt for the OG/twitter image (accessibility + best practice). */
  ogImageAlt?: string;
  /** Emit <meta name="robots" content="noindex"> — used by /404 so error pages
   *  stay out of the index. */
  noindex?: boolean;
  /** Prefilled mailto subject for this page's CTAs (header + footer). Keeps the
   *  one-action/no-funnel model while giving the reader a contextual starting
   *  line. Omit for a bare mailto. */
  contactSubject?: string;
}
const {
  title,
  description,
  ogImage = "/og-image.png",
  ogImageAlt = "burningsuit — Power BI & Fabric advisory, done with you, with an eye on what AI changes",
  noindex = false,
  contactSubject,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const contactEmail = CONTACT_EMAIL;
const mailtoHref = contactSubject
  ? `mailto:${contactEmail}?subject=${encodeURIComponent(contactSubject)}`
  : `mailto:${contactEmail}`;

// ProfessionalService structured data. Company-number-bearing fields (legalName,
// registration) are deliberately omitted until the real Companies House number
// lands (Stage 0). Astro's security.csp hashes this is:inline block into
// script-src; ld+json isn't executed, so it's data, not behaviour.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "burningsuit",
  description:
    "Embedded Power BI and Fabric advisory, done with you — strategy, architecture review, and team capability — with a clear-eyed take on what AI means for how the work gets built.",
  url: Astro.site?.href ?? "https://burningsuit.co.uk/",
  email: contactEmail,
  founder: { "@type": "Person", name: "Alan Harman-Box" },
  areaServed: "GB",
  address: { "@type": "PostalAddress", addressRegion: "West Sussex", addressCountry: "GB" },
  serviceType: ["Power BI advisory", "Microsoft Fabric advisory", "AI advisory for data teams"],
});
const hasFooterInvitation = Astro.slots.has("footer-invitation");
---
<!doctype html>
<html lang="en-GB" data-theme="aubergine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- first paint: mark JS so reveal-hidden states only exist with JS on -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {!noindex && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <!-- self-hosted fonts (subset + preloaded at build) -->
    <Font cssVariable="--font-mona" preload />
    <Font cssVariable="--font-albert" preload />
    <Font cssVariable="--font-commit" preload />

    {/* Cookieless analytics — OFF by default. Flipping ANALYTICS.enabled also
        requires the matching ANALYTICS_ENABLED flag in astro.config.mjs (it
        adds the provider host to script-src + connect-src). is:inline keeps the
        external src untouched; it's governed by the script-src host, not a hash. */}
    {ANALYTICS.enabled && (
      <script is:inline defer data-domain={ANALYTICS.dataDomain} src={ANALYTICS.scriptSrc} />
    )}
  </head>
  <body>
    <Header mailtoHref={mailtoHref} />
    <main>
      <slot />
    </main>
    <Footer mailtoHref={mailtoHref}>
      {
        hasFooterInvitation && (
          <Fragment slot="invitation">
            <slot name="footer-invitation" />
          </Fragment>
        )
      }
    </Footer>

    <!-- progressive enhancement, bundled to an external module (script-src
         'self'). Also carries the console greeting for anyone reading the
         source — kept in the bundled module (not a second inline script) so the
         meta-CSP covers it without an extra hash to keep in sync. -->
    <script>
      import "../scripts/enhance.ts";
    </script>
  </body>
</html>
