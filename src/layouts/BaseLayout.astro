---
/**
 * The document shell. Renders <head> (meta/OG, self-hosted <Font> tags, the
 * bundled enhancement module and analytics tracker), the sticky Header, the
 * page's <main>, and the fixed basement Footer.
 *
 * The CSP <meta http-equiv> is injected automatically by Astro's `security.csp`
 * feature — do NOT add one here by hand. The page ships NO hand-written inline
 * scripts: the `.js` reveal gate is armed inside the bundled enhance.ts module
 * (which the build inlines as a module script and auto-hashes into script-src —
 * hashes exist, and they're byte-sensitive, hence the LF-only rule), and the
 * cookieless Plausible tracker is governed by its explicit CSP host.
 */
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/seo/Schema.astro";
import { CONTACT_EMAIL, ANALYTICS } from "../config/site";
import { siteGraph, type SchemaNode } from "../lib/schema";
import "../styles/app.css";

interface Props {
  title: string;
  description: string;
  /** OG/twitter image, served from the site root. */
  ogImage?: string;
  /** Descriptive alt for the OG/twitter image (accessibility + best practice). */
  ogImageAlt?: string;
  /** Pixel dimensions of the ogImage. Scrapers lay the preview out from these
   *  BEFORE fetching the file, so an override that isn't 1200×630 must pass its
   *  real dimensions too. Defaults describe the stock /og-image.png. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Emit <meta name="robots" content="noindex"> — used by /404 so error pages
   *  stay out of the index. */
  noindex?: boolean;
  /** Prefilled mailto subject for the page's email path (the footer "email me"
   *  and any page-level mailto). Part of the two-path funnel — book a call +
   *  email — giving the reader a contextual starting line. Omit for a bare
   *  mailto. */
  contactSubject?: string;
  /** og:type — "website" (default) for landing pages, "article" for editorial
   *  pages (case studies / blog). Drives the article:* time tags below. */
  ogType?: "website" | "article";
  /** ISO timestamps for og:article — emitted only when ogType is "article". */
  publishedTime?: string;
  modifiedTime?: string;
  /** Page-specific JSON-LD node(s) — Article, BreadcrumbList, FAQPage, etc.
   *  Appended to the site-wide identity graph and emitted as one @graph block.
   *  The site graph (Organization/Person/WebSite) is always present; pages add
   *  only what's specific to them. */
  jsonLd?: SchemaNode | SchemaNode[];
}
const {
  title,
  description,
  ogImage = "/og-image.png",
  ogImageAlt = "burningsuit - Power BI & Fabric advisory, done with you, even as AI takes on the typing",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
  contactSubject,
  ogType = "website",
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const contactEmail = CONTACT_EMAIL;
const mailtoHref = contactSubject
  ? `mailto:${contactEmail}?subject=${encodeURIComponent(contactSubject)}`
  : `mailto:${contactEmail}`;

// Structured data: the site-wide identity graph (Organization/Person/WebSite,
// from src/config/site.ts) plus any page-specific node(s). Assembled here and
// emitted once via <Schema> as a connected @graph. See src/lib/schema.ts.
const siteUrl = Astro.site?.href ?? "https://burningsuit.co.uk/";
const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graph: SchemaNode[] = [...siteGraph(siteUrl), ...pageNodes];
const hasFooterInvitation = Astro.slots.has("footer-invitation");
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* noindex pages emit no canonical either — a canonical on a noindexed
        page sends the mixed signal the Schema noindex gate exists to avoid. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && (modifiedTime ?? publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <Schema schema={graph} noindex={noindex} />

    <!-- self-hosted fonts (subset + preloaded at build) -->
    <Font cssVariable="--font-mona" preload />
    <Font cssVariable="--font-albert" preload />
    <Font cssVariable="--font-commit" preload />

    {/* Cookieless analytics. The matching ANALYTICS_ENABLED flag in
        astro.config.mjs adds the provider host to script-src + connect-src.
        is:inline keeps the external src untouched; it is governed by the
        script-src host, not a hash. Init lives in enhance.ts (the queue stub
        is safe in either load order), so no inline snippet is needed. */}
    {ANALYTICS.enabled && <script is:inline async src={ANALYTICS.scriptSrc} />}
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <Header mailtoHref={mailtoHref} />
    <main id="main">
      <slot />
    </main>
    <Footer mailtoHref={mailtoHref}>
      {
        hasFooterInvitation && (
          <Fragment slot="invitation">
            <slot name="footer-invitation" />
          </Fragment>
        )
      }
    </Footer>

    <!-- Progressive enhancement, bundled to a first-party external module. It
         arms the html.js reveal gate first thing, so if it ever fails to load or
         execute, no hidden state is armed and the page stays fully visible. It
         also carries the console greeting for anyone reading the source. -->
    <script>
      import "../scripts/enhance.ts";
    </script>
  </body>
</html>
