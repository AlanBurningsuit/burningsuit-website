---
/** Temporary comparison shell. Only the DEV-gated preview route imports it. */
import { Font } from "astro:assets";
import { bookingHref, mailtoFor } from "../config/site";
import Signoff from "../components/Signoff.astro";
import "../styles/ownership.css";

interface Props {
  direction: "elevated" | "personal";
  page: "home" | "power-bi";
}
const { direction, page } = Astro.props;
const basePath = `/design-preview/${direction}`;
const other = direction === "elevated" ? "personal" : "elevated";
const suffix = page === "home" ? "/" : "/power-bi/";
const label = direction === "elevated" ? "A — Aligned and elevated" : "B — Bold and personal";
const subject = page === "home" ? "Power BI & Fabric" : "Power BI & Fabric - where it's stuck";
const navigation = [
  { href: `${basePath}/power-bi/`, label: "Power BI", current: page === "power-bi" },
  { href: "/ai-fit-for-teams/", label: "AI" },
  { href: "/work/", label: "Case studies" },
  { href: "/about/", label: "About" },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{label} · {page === "home" ? "Home" : "Power BI"} · burningsuit preview</title>
    <meta name="description" content="Local design comparison for the burningsuit ownership-led website." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-mona" preload />
    <Font cssVariable="--font-albert" preload />
    <Font cssVariable="--font-commit" preload />
  </head>
  <body class:list={["ownership", `o-theme-${direction}`, `o-page-${page}`]}>
    <a class="o-skip" href="#main">Skip to content</a>
    <aside class="o-preview-bar" aria-label="Design comparison">
      <div class="o-wrap o-preview-inner">
        <span>{label}</span>
        <nav aria-label="Preview pages">
          <a href={`${basePath}/`} aria-current={page === "home" ? "page" : undefined}>Home</a>
          <a href={`${basePath}/power-bi/`} aria-current={page === "power-bi" ? "page" : undefined}>Power BI</a>
          <a href={`/design-preview/${other}${suffix}`}>Compare {direction === "elevated" ? "B" : "A"} <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </aside>
    <header class="o-header">
      <div class="o-wrap o-header-inner">
        <a class="o-logo" href={`${basePath}/`} aria-label="burningsuit — home">
          <img src={direction === "elevated" ? "/logos/burningsuit-on-green.svg" : "/logos/burningsuit-full-colour.svg"} width="285" height="52" alt="burningsuit" />
        </a>
        <nav aria-label="Main">
          {navigation.map((item) => <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>)}
        </nav>
        <a class="o-header-action" href={bookingHref("header")} target="_blank" rel="noopener noreferrer">Book a call <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="o-footer" aria-labelledby="o-contact-title">
      <div class="o-wrap">
        <div class="o-footer-top">
          <div>
            <p class="o-eyebrow">A conversation with Alan</p>
            <h2 id="o-contact-title">Tell me where<br />you’d like to get to.</h2>
          </div>
          <div class="o-footer-invitation">
            <p>Tell me what your team is working on and where it’s getting stuck. We can work out whether I can help.</p>
            <div class="o-actions">
              <a class="o-button" href={bookingHref("footer")} target="_blank" rel="noopener noreferrer">Book a 30-minute call <span aria-hidden="true">↗</span></a>
              <a class="o-button o-button-secondary" href={mailtoFor(subject)}>Email me <span aria-hidden="true">↗</span></a>
            </div>
            <Signoff />
          </div>
        </div>
        <div class="o-footer-bottom">
          <a class="o-logo" href={`${basePath}/`}><img src="/logos/burningsuit-on-green.svg" alt="burningsuit — home" width="285" height="52" /></a>
          <p>Burningsuit Limited · Registered in England &amp; Wales, no. 05738130<br />The Courtyard, Shoreham Road, Upper Beeding, West Sussex, BN44 3TN</p>
          <p>© 2026<br /><a href="/privacy/">Privacy</a></p>
        </div>
      </div>
    </footer>
    {/* Local comparisons do not load the production analytics tracker. Existing
        attributes and enhancement behaviour stay testable without adding visits. */}
    <script>
      import "../scripts/enhance.ts";
    </script>
  </body>
</html>
