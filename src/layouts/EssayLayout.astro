---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TitleBand from "../components/TitleBand.astro";
import Newsletter from "../components/Newsletter.astro";
import { dayText, isoDay, leadParts, monthText } from "../lib/writing";
import "../styles/articles.css";
interface Props { essay: CollectionEntry<"writing">["data"] }
const { essay } = Astro.props;
// An archive post is dated at its source's precision (a month, or a day), with its author's own revision if there was one.
// An essay dated only by publication (no talk dates under its byline) shows that day.
const bylineDate = essay.kind !== "archive" ? (essay.givenAt?.length || !essay.datePublished ? undefined : { iso: isoDay(essay.datePublished), text: dayText(essay.datePublished) })
  : essay.datePublished ? { iso: isoDay(essay.datePublished), text: dayText(essay.datePublished) }
  : essay.archiveMonth ? { iso: essay.archiveMonth, text: monthText(essay.archiveMonth) } : undefined;
// The Article's dates (JSON-LD) at the source's precision: an archive post dated only by month gives just its month.
const datePublished = essay.datePublished ? isoDay(essay.datePublished) : essay.archiveMonth;
---
<BaseLayout title={essay.title} description={essay.description} author={essay.author} ogType="article" datePublished={datePublished} dateModified={essay.dateModified && isoDay(essay.dateModified)}>
  <article class="reading-article" aria-labelledby="page-title">
    <TitleBand heading={essay.heading} standfirstClass="article-lead">
      <Fragment slot="eyebrow"><a href="/writing/">Writing</a> · {essay.kicker}</Fragment>
      {essay.lead && <Fragment slot="standfirst">{leadParts(essay.lead).map(({ text, code }) => code ? <code>{text}</code> : text)}</Fragment>}
    </TitleBand>
    <header class="article-opening wrap">
      <p class="article-byline">{essay.author}{bylineDate && <> · <time datetime={bylineDate.iso}>{bylineDate.text}</time></>}{essay.revisedMonth && <> · Revised by {essay.author}, <time datetime={essay.revisedMonth}>{monthText(essay.revisedMonth)}</time></>}</p>
      {essay.givenAt && <div class="article-appearances">{essay.givenAt.map(({ event, date }) => <p>Given at {event}, <time datetime={isoDay(date)}>{dayText(date)}</time>.</p>)}</div>}
      {essay.updateNotice && <div class="article-appearances"><p>{essay.updateNotice}</p><p>Update notes are by Alan Harman-Box.</p></div>}
    </header>
    <slot />
  </article>
  <Newsletter />
  <div class="article-related closing-band dark"><div class="wrap closing-inner"><div class="links">
    {essay.kind !== "archive" && <a href={essay.course?.href ?? "/training/power-bi-with-ai-agents-101/"}>{essay.course?.name ?? "Power BI with AI agents 101"}</a>}
    <a href="/writing/">Writing</a>
    <a href="/about/">About</a>
    <a href="/training/">Training</a>
    <a href="/power-bi/">Consultancy</a>
  </div></div></div>
</BaseLayout>
