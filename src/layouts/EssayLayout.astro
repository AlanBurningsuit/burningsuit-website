---
/**
 * /writing/<slug> — an essay in the site's existing chaptered reading layout.
 * The Article references Alan's Person node; the breadcrumb goes directly
 * from Home to the essay because there is no writing index yet.
 */
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { articleNode, breadcrumbList } from "../lib/schema";
import { KIT_ESSAY_FORM_ACTION } from "../config/site";
import { NOTES_FORM_ID } from "../config/asks";

interface Props {
  essay: CollectionEntry<"writing">["data"];
}
const { essay } = Astro.props;
const { kicker, heading, lead, title, description, contactSubject, footerInvitation, givenAt } = essay;
const siteUrl = Astro.site?.href ?? "https://burningsuit.co.uk/";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const publishedTime = essay.datePublished?.toISOString();
const modifiedTime = essay.dateModified?.toISOString();
const article = articleNode({
  siteUrl,
  pageUrl,
  headline: [heading.before, heading.em, heading.after].filter(Boolean).join("").trim(),
  description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
});
const crumbs = breadcrumbList([
  { name: "Home", url: siteUrl },
  { name: title.replace(/ - burningsuit$/, ""), url: pageUrl },
]);
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", {
  day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
}).format(date);
---

<BaseLayout
  title={title}
  description={description}
  contactSubject={contactSubject}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={[article, crumbs]}
  ask="subscribe"
>
  <Fragment slot="footer-invitation">{footerInvitation}</Fragment>

  <section class="page-hero">
    <div class="wrap">
      <p class="kicker meta enter">{kicker}</p>
      <h1 class="enter appear-300">
        {heading.before}<em>{heading.em}</em>{heading.after}
      </h1>
      <p class="lead enter appear-450">{lead}</p>
      {givenAt && givenAt.length > 0 && (
        <div class="prose">
          {givenAt.map(({ event, date }) => <p class="meta">Given at {event}, <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>.</p>)}
        </div>
      )}
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <slot />

  {/* Every essay ends with its one ask: an inline Kit signup, a plain HTML
      form (no Kit script, no popup) posting to the essays-only Kit form. The
      form sits outside the reveal-gated prose, as contact controls never wait
      on an entrance. data-track-form names the Umami event (enhance.ts). */}
  <section class="chapter" aria-labelledby={NOTES_FORM_ID}>
    <div class="wrap">
      <div class="prose" data-reveal>
        <hr />
        <h2 class="notes-head" id={NOTES_FORM_ID}>Notes from burningsuit</h2>
        <p data-placeholder>[Placeholder: one line on what the notes are and how often they come.]</p>
      </div>
      <form class="notes-form" action={KIT_ESSAY_FORM_ACTION} method="post" data-track-form="Notes signup" data-placement="essay">
        <label for="notes-email">Email address</label>
        <div class="notes-row">
          <input id="notes-email" type="email" name="email_address" autocomplete="email" required />
          <button class="cta" type="submit">Subscribe</button>
        </div>
      </form>
      <div class="routes"><a class="route" href="/about/">More about me, and the work I do</a></div>
    </div>
  </section>

  <div class="thread thread-end thread-tight" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer"></div>
</BaseLayout>
