---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TitleBand from "../components/TitleBand.astro";
import "../styles/articles.css";
interface Props { essay: CollectionEntry<"writing">["data"] }
const { essay } = Astro.props;
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(date);
const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const archiveContext = essay.archiveMonth ? `${months[Number(essay.archiveMonth.slice(5)) - 1]} ${essay.archiveMonth.slice(0, 4)}` : undefined;
---
<BaseLayout title={essay.title} description={essay.description} author={essay.author} ogType="article" placeholder={false}>
  <article class="reading-article" aria-labelledby="page-title">
    <TitleBand heading={essay.heading} standfirstClass="article-lead">
      <Fragment slot="eyebrow">{essay.kicker}</Fragment>
      {essay.lead && <Fragment slot="standfirst">{essay.lead}</Fragment>}
    </TitleBand>
    <header class="article-opening wrap">
      <p class="article-byline">{essay.author}{archiveContext && <> · <time datetime={essay.archiveMonth}>{archiveContext}</time></>}</p>
      {essay.givenAt && <div class="article-appearances">{essay.givenAt.map(({ event, date }) => <p>Given at {event}, <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>.</p>)}</div>}
    </header>
    <slot />
  </article>
  <div class="article-related closing-band dark"><div class="wrap closing-inner"><div class="links">
    {essay.kind === "essay" && <a href="/training/agentic-development-for-power-bi/">Power BI with AI agents 101</a>}
    <a href="/about/">About</a>
    <a href="/training/">Training</a>
    <a href="/power-bi/">Consultancy</a>
  </div></div></div>
</BaseLayout>
