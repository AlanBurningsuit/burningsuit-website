---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/service.css";
---
<BaseLayout title="Message sent | burningsuit" description="Your enquiry has been sent to Alan." placeholder={false}>
  <section class="wrap service-page" aria-labelledby="result-title">
