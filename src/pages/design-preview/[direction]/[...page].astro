---
import OwnershipPreviewLayout from "../../../layouts/OwnershipPreviewLayout.astro";
import HomeContent from "../../../components/ownership/HomeContent.astro";
import PowerBiContent from "../../../components/ownership/PowerBiContent.astro";

// No environment override: a normal or CI production build can never emit these
// comparison pages. Remove this route and the unused treatment after selection.
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return ["elevated", "personal"].flatMap((direction) => [
    { params: { direction, page: undefined }, props: { direction, page: "home" } },
    { params: { direction, page: "power-bi" }, props: { direction, page: "power-bi" } },
  ]);
}
const { direction, page } = Astro.props as {
  direction: "elevated" | "personal";
  page: "home" | "power-bi";
};
const basePath = `/design-preview/${direction}`;
---
<OwnershipPreviewLayout direction={direction} page={page}>
  {page === "home" ? <HomeContent basePath={basePath} /> : <PowerBiContent basePath={basePath} />}
</OwnershipPreviewLayout>
