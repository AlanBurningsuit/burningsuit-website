---
/** One essay, rendered with the same chapter components as the case studies. */
import { getCollection, render } from "astro:content";
import EssayLayout from "../../layouts/EssayLayout.astro";
import Chapter from "../../components/Chapter.astro";
import Aside from "../../components/Aside.astro";
import Exhibit from "../../components/Exhibit.astro";
import EssayFigure from "../../components/EssayFigure.astro";

export async function getStaticPaths() {
  const essays = await getCollection("writing");
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EssayLayout essay={entry.data}>
  <Content components={{ Chapter, Aside, Exhibit, EssayFigure }} />
</EssayLayout>
