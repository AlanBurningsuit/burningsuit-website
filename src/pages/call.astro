---
// Wording: ops site/hour-page-copy.md (the page moved from /hour/ to /call/ once the call became 30 minutes). Bracketed items there are layout notes, not copy.
// No reserved anchors (see src/config/compatibility.mjs). No form, embed or script: plain links to booking, Contact, About and consultancy.
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleBand from "../components/TitleBand.astro";
import Tracked from "../components/Tracked.astro";
import { EVENTS } from "../config/analytics.mjs";
import "../styles/course.css";
import "../styles/consultancy.css";
import "../styles/call.css";

const booking = "https://cal.com/alan-burningsuit/call";
---
<BaseLayout
  title="Free 30-minute Power BI call | burningsuit"
  description="Book a free 30-minute call with me, Alan Harman-Box, about your own Power BI. Talk through what's happening and whether I can help."
>
  <TitleBand heading={{ before: "A ", em: "free", after: " 30-minute call about your Power BI" }}>
    <Fragment slot="standfirst">Got a problem with your own Power BI, and not sure whether I can help?</Fragment>
  </TitleBand>
  <div class="course-opening call-opening wrap">
    <section class="course-intro" aria-labelledby="page-title">
      <p>I'm Alan Harman-Box. Tell me about it on a call. Maybe your reporting all rests on one person, or two reports give different answers to the same question, or it's something you can't quite put a name to yet. You don't need a polished brief to book.</p>
    </section>

    <section class="course-run" aria-label="Call facts and booking">
      <ul class="run-facts" role="list">
        <li>30 minutes, free</li>
        <li>On Microsoft Teams</li>
        <li>You talk to me, Alan</li>
        <li>Follow-up afterwards if it needs more thought</li>
        <li>Any further work quoted separately</li>
      </ul>
      <Tracked event={EVENTS.bookCall} place="top"><a class="button book-link" href={booking}>Book a free 30-minute call</a></Tracked>
    </section>

    <section class="call-steps" aria-labelledby="happens-title">
      <h2 id="happens-title">What happens</h2>
      <ol class="do-steps" role="list">
        <li><h3>On the call.</h3><p>You tell me what's going on, and I ask questions to understand it better. We stay on what matters most to you. Sometimes that's enough: I can point you to what to do next, or tell you if it isn't something I can help with.</p></li>
        <li><h3>Afterwards.</h3><p>If I need more time to think about it, I'll follow up after the call. If there's work I can help with, I'll quote for it separately, usually as a fixed price.</p></li>
      </ol>
    </section>
  </div>

  <section class="course-book call-book closing-band dark" aria-labelledby="book-title">
    <div class="wrap closing-inner">
      <div>
        <h2 id="book-title">Book your call</h2>
        <p class="book-facts">You'll be talking to me, and if we go on to work together, I'm the one who does the work. <a href="/about/">More about me</a></p>
        <p class="book-facts">Pick a time that suits you on my booking page.</p>
      </div>
      <div>
        <Tracked event={EVENTS.bookCall} place="bottom"><a class="button book-link" href={booking}>Book a free 30-minute call</a></Tracked>
        <p class="call-alt">Prefer to write? <a href="/contact/">Send me a message</a></p>
        <p class="call-alt"><a href="/power-bi/">More about my consultancy</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
