---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCta from "../components/BookCta.astro";
import { mailtoFor } from "../config/site";

const contactSubject = "What our reporting can't do yet";
const contactMailto = mailtoFor(contactSubject);
---

<BaseLayout title="Tell me what your reporting can't do (yet) - burningsuit" description="A free hour on a call with Alan Harman-Box to get you unstuck: where the reporting has stalled, what kind of problem it is, and what to do next. Nothing to show, nothing to diagnose first." contactSubject={contactSubject}>
  <Fragment slot="footer-invitation">Or just write to me about whatever you're stuck on. Replies come from me</Fragment>
  <section class="page-hero hour-hero">
    <div class="wrap hour-layout">
      <div class="hour-copy">
      <h1 class="enter appear-300">Tell me what your reporting can't do (<em>yet</em>).</h1>
      <p class="lead enter appear-450">Let's get you unstuck on whatever you're stuck on. It's an hour on a call, it's free, and you don't need to have worked out what's wrong before we talk. You tell me where the reporting has ground to a halt, or what the team keeps not quite managing to do, and I'll help you work out what kind of stuck it is - a scope problem, a skills problem, or something else entirely - and what a sensible next step looks like. You don't need to show me anything, either.</p>
      </div>
      <div class="hour-details">
      <div class="prose">
        <ol class="beats beats-body">
          <li><strong>Before:</strong> book a slot and spend five minutes on the form's two questions, “What does your team need to be able to do that it can't yet?” and “What's been tried so far, and by whom?” It means we can skip the preamble.</li>
          <li><strong>During:</strong> we talk for an hour. You describe, I ask, and between us we work out which kind of stuck this is.</li>
          <li><strong>After:</strong> you leave knowing what to do next. Sometimes that involves me and sometimes it doesn't, and I'll tell you straight either way.</li>
        </ol>
      </div>
      <BookCta src="hour-page" mailtoHref={contactMailto} variant="hero" />
      </div>
    </div>
  </section>
</BaseLayout>
