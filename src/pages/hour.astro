---
/**
 * /hour: the free hour, consultancy's ask, written to the website-page
 * playbook: what happens in the hour, who it's for and what they'll leave
 * with, then one action, book the hour. It never mentions courses. The whole
 * offer and its contact actions fit the first desktop screen (journeys test),
 * so keep it short.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCta from "../components/BookCta.astro";
import { mailtoFor } from "../config/site";

const contactSubject = "What our reporting can't do yet";
const contactMailto = mailtoFor(contactSubject);
---

<BaseLayout title="A free hour on a call about your reporting - burningsuit" description="A free hour on a call with Alan Harman-Box for when your own reports or models are stuck: you describe it, he asks, and you leave knowing what kind of problem it is and what to do next." contactSubject={contactSubject}>
  <Fragment slot="footer-invitation">Or just write to me about whatever you're stuck on. Replies come from me</Fragment>
  <section class="page-hero hour-hero">
    <div class="wrap hour-layout">
      <div class="hour-copy">
      <h1 class="enter appear-300">A free hour on a call, for when your reporting is <em>stuck</em>.</h1>
      <p class="lead enter appear-450">Tell me what your reporting can't do (yet). It might be a report only one person can change, numbers nobody trusts, or something the team keeps not quite managing to do. You don't need to have worked out what's wrong, and you don't need to show me anything.</p>
      </div>
      <div class="hour-details">
      <div class="prose">
        <ol class="beats beats-body">
          <li><strong>Before:</strong> book a time and spend five minutes on the two questions: "What would you like to talk through?" and, if you can, "What's been tried so far, and by whom?" It means we can skip the preamble.</li>
          <li><strong>During:</strong> we talk for up to an hour. You describe, I ask, and between us we work out what kind of stuck it is. If that's clear in twenty minutes, you get the rest of your hour back.</li>
          <li><strong>After:</strong> you leave knowing what to do next. Sometimes that involves me and sometimes it doesn't, and I'll tell you straight either way.</li>
        </ol>
      </div>
      <BookCta src="hour-page" mailtoHref={contactMailto} variant="hero" />
      </div>
    </div>
  </section>
</BaseLayout>
