---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found - burningsuit"
  description="That page isn't here. Here's the way back."
  noindex
>
  <Fragment slot="footer-invitation"
    >You came looking for something and didn't find it. Tell me what it was, and I'll point you the right way</Fragment
  >

  <section class="page-hero notfound" data-track-404>
    <div class="wrap">
      <p class="kicker meta enter">Error 404</p>
      <h1 class="enter appear-300">There's <em>nothing</em> here.</h1>
      <p class="lead enter appear-450">
        Either the link was wrong, or I moved something and didn't leave a
        forwarding note. It's not your fault either way.
      </p>
      <nav class="routes notfound-links enter appear-600" aria-label="Where to next">
        <a class="route" href="/">Home</a>
        <a class="route" href="/training/agentic-101/">The 101</a>
        <a class="route" href="/training/">Courses</a>
        <a class="route" href="/power-bi/">Consultancy</a>
        <a class="route" href="/hour/">A free hour on a call</a>
        <a class="route" href="/work/">Case studies</a>
        <a class="route" href="/about/">About</a>
      </nav>
    </div>
  </section>
</BaseLayout>
