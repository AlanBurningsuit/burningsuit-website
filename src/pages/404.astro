---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found - burningsuit"
  description="That page isn't here. Here's the way back."
  noindex
>
  <Fragment slot="footer-invitation"
    >You came looking for something and didn't find it. Tell me what it was -
    I'll point you the right way</Fragment
  >

  <section class="page-hero notfound" data-track-404>
    <div class="wrap">
      <p class="kicker meta enter">Error 404</p>
      <h1 class="enter appear-300">There's <em>nothing</em> here.</h1>
      <p class="lead enter appear-450">
        Either the link was wrong, or I moved something and didn't leave a
        forwarding note. Not your fault either way.
      </p>
      <nav class="notfound-links enter appear-600" aria-label="Where to next">
        <a class="u" href="/">Home</a>
        <a class="u" href="/power-bi/">Power BI</a>
        <a class="u" href="/ai-fit-for-teams/">AI Fit for Teams</a>
        <a class="u" href="/work/">Case studies</a>
        <a class="u" href="/about/">About</a>
      </nav>
    </div>
  </section>
</BaseLayout>
