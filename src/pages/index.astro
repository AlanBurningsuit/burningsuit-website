---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiseHeading from "../components/RiseHeading.astro";
import ServiceRows from "../components/ServiceRows.astro";
import type { RowData } from "../components/ServiceRow.astro";
import PrinciplesChapter from "../components/PrinciplesChapter.astro";
import PhotoChapter from "../components/PhotoChapter.astro";
import StatementChapter from "../components/StatementChapter.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
import BookCta from "../components/BookCta.astro";
import type { Line } from "../components/RiseHeading.astro";
import { Picture } from "astro:assets";
import heroPhoto from "../assets/photos/DSC08670-Edit.jpg";
import { mailtoFor } from "../config/site";
import { getEntry } from "astro:content";
import { namedTier } from "../lib/named";

const contactSubject = "Power BI & Fabric";
const contactMailto = mailtoFor(contactSubject);

// Homepage proof beat: one concrete outcome from the law-firm study. The subject
// reads as the named client only when that study's namePublished gate opens
// (namedTier() — the same audited gate the /power-bi teaser and the study page
// use) — otherwise the anonymised form.
const lawFirm = await getEntry("work", "law-firm");
const proofWho = namedTier(lawFirm?.data)?.client ?? "A data team inside an international law firm";

const heroLabel = "power bi and fabric, done with you.";
const heroLines: Line[] = ["power bi & fabric,", { before: "done ", em: "with", after: " you." }];

const serviceRows: RowData[] = [
  {
    href: "/power-bi/",
    title: { before: "power bi & fabric, done ", em: "with", after: " you" },
    body: "Your reporting works, but the team can't fully own it - a black box only whoever built it can safely touch. Embedded advisory, reporting strategy and architecture review - I help the whole team feel like they've got it, so a small team gets further and the know-how stays with you when I leave.",
    cta: "see power bi & fabric",
  },
  {
    href: "/ai-fit-for-teams/",
    title: { before: "ai ", em: "fit", after: " for teams" },
    body: "You're licensed for Copilot, and it hasn't quite paid off - some of it sitting idle, some of it writing DAX nobody can fully vouch for. What pays off is getting genuinely good with AI without handing over your judgement, so a stretched team does more, and better. I help you work out what to hand over, what to keep, and who checks what.",
    cta: "see ai fit for teams",
  },
];

const principles = [
  {
    title: "the answers are yours",
    body: "I help your team reach the right answers for how you actually work, instead of arriving with mine. Understand your own models and data well enough to judge what's safe to hand to a tool.",
  },
  {
    title: "what not to automate",
    body: "Knowing what not to automate matters as much as knowing what to. As the tools take on more of the build, the discipline is choosing which decisions you let them make - and staying conscious of where you've made the call.",
  },
  {
    title: "mental models first",
    body: "When a tool writes the DAX or builds the model, someone on your team still has to read it back and know whether it holds up. I help them build that judgement, so they catch a number that only looks right before it goes out.",
  },
];

const statementLines: Line[] = [
  "ai will build whatever you ask.",
  "someone still has to know",
  { before: "what to ask ", em: "for", after: "." },
];
---

<BaseLayout
  title="Power BI & Fabric advisory, done with you - burningsuit"
  description="Embedded Power BI and Fabric advisory, done with you - ongoing work inside your team, so the know-how stays with you when I leave, even as AI takes on the typing."
  contactSubject={contactSubject}
>
  <Fragment slot="footer-invitation"
    >Tell me what your Power BI or Fabric team is wrestling with, and where you'd
    like it to get to. Replies come from me</Fragment
  >

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker hero-prompt">
          <span class="pre" aria-hidden="true">›</span><span class="kt"
            >power bi &amp; fabric advisory</span
          ><span class="cursor" aria-hidden="true"></span>
        </p>
        <RiseHeading as="h1" kind="hero" label={heroLabel} lines={heroLines} />
        <p class="lede enter appear-300">
          I help your team get more capable with Power BI and Fabric, and
          <strong>keep the work yours, even as AI takes on the typing</strong>.
        </p>
        <p class="hero-sig enter appear-450">
          I'm Alan. I've spent five years with teams adopting Power BI, and a
          decade building software before that.
        </p>
        <BookCta src="hero" mailtoHref={contactMailto} variant="hero" rowClass="enter appear-600" />
      </div>
      <figure class="hero-photo enter appear-300">
        <Picture
          src={heroPhoto}
          alt="Alan, who runs burningsuit, sitting outdoors and smiling"
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[400, 600, 800]}
          sizes="(min-width: 62rem) 40vw, 100vw"
          quality={66}
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter" aria-labelledby="what">
    <div class="wrap what">
      <div class="label">
        <h2 class="kicker meta" id="what" data-reveal>what i do</h2>
      </div>
      <div>
        <ServiceRows rows={serviceRows} />
      </div>
    </div>
    <div class="wrap what proof-line">
      <div class="label">
        <p class="kicker meta" data-reveal>in practice</p>
      </div>
      <div class="proof-body" data-reveal>
        {proofWho}, wary of a Fabric build they hadn't made, found the error the
        migration missed. <a class="u" href="/work/">see the work ▸</a>
      </div>
    </div>
  </section>

  <section class="cta-band" aria-label="book a call">
    <div class="wrap">
      <BookCta src="home-proof" mailtoHref={contactMailto} reveal>
        If that's where you are too, I'm happy to talk it through - nothing to prepare.
      </BookCta>
    </div>
  </section>

  <PrinciplesChapter kicker="how i work" headingId="how" principles={principles} />

  <PhotoChapter />

  <StatementChapter
    label="ai will build whatever you ask. someone still has to know what to ask for."
    lines={statementLines}
  />

  <AboutTeaser />

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer"></div>
</BaseLayout>
