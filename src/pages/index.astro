---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiseHeading from "../components/RiseHeading.astro";
import Chapter from "../components/Chapter.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Exhibit from "../components/Exhibit.astro";
import DoorRow from "../components/DoorRow.astro";
import type { RowData } from "../components/ServiceRow.astro";
import StatementChapter from "../components/StatementChapter.astro";
import PhotoChapter from "../components/PhotoChapter.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
import type { Line } from "../components/RiseHeading.astro";
import { Picture } from "astro:assets";
import heroPhoto from "../assets/photos/DSC08670-Edit.jpg";
import { mailtoFor } from "../config/site";
import { course } from "../config/training";

const contactSubject = "Power BI and AI training";
const contactMailto = mailtoFor(contactSubject);
const intro = course("agentic-101");
const interestHref = mailtoFor(`${intro.title} - register interest`);
// The tagline, hand-split for the hero's 15ch measure. Check the hero height on preview.
const heroLines: Line[] = ["Power BI and AI", "for people whose", { before: "job ", em: "isn't", after: "" }, "Power BI or AI."];
const courseDoors: RowData[] = [
  { href: "/training/#power-bi-courses", title: { before: "Power BI, from a first report to DAX you ", em: "understand", after: "." }, body: `${course("power-bi-fundamentals").title}, ${course("dax-fundamentals").title}, the ${course("dax-deep-dive").title} and ${course("data-modelling").title}. One or two days each, for a closed group of up to 8, on site or remote.`, cta: "See the Power BI courses" },
  { href: "/training/#ai-at-work", title: { before: "Claude, at ", em: "work", after: "." }, body: `${course("claude-day-job").title}, a day for any role with no technical background needed, and ${course("claude-consultants").title}, a day on capturing a method in an agent skill and testing it on a colleague's work.`, cta: "See the AI days" },
];
const consultancyDoor: RowData = { href: "/power-bi/", title: { before: "When it's your own reporting ", em: "problem", after: "." }, body: "I work alongside your team on the real thing, whether that's a report to deliver or a system you've inherited, and give the person leading it someone to think it through with.", cta: "See how consultancy works" };
const evidenceRows: RowData[] = [
  { href: "/work/contact-centre/", tab: "A national contact centre", title: { before: "She built the dashboard ", em: "herself", after: "." }, body: "A team lead had stalled when she tried Power BI on her own data. In one of our sessions, she reached for the right function before I got there - she recognised it from Excel.", cta: "Read the contact-centre story" },
  { href: "/work/law-firm/", tab: "An international law firm", title: { before: "They ", em: "own", after: " a system someone else built." }, body: "A consultancy built their Fabric system. I worked with the team while it was happening. By handover, they were tracing wrong numbers through the new stack and finding the likely cause themselves.", cta: "Read the law-firm story" },
];
const statementLines: Line[] = [
  "AI will build",
  "whatever you ask.",
  "Someone still has to",
  { before: "know what to ask ", em: "for", after: "." },
];
---

<BaseLayout title="Power BI and AI training - burningsuit" description="Power BI and AI training for people whose job isn't Power BI or AI. Courses for teams from Alan Harman-Box, with consultancy when the problem is your own reporting." contactSubject={contactSubject}>
  <Fragment slot="footer-invitation">Tell me what your team needs to learn, or what your reporting is wrestling with. Replies come from me</Fragment>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <RiseHeading as="h1" kind="hero" label="Power BI and AI for people whose job isn't Power BI or AI." lines={heroLines} />
        <div class="hero-introduction enter appear-300">
          <p>I'm Alan. I've worked with teams on Power BI and Fabric for the last five years, and spent a decade in software before that.</p>
          <p class="hero-motivation">I teach Power BI, and how to put AI to work, in practical courses for teams. I want people to leave knowing why it works, so they can question a number or change it with confidence.</p>
        </div>
        <div class="cta-row">
          <a class="cta" href="/training/">See the courses</a>
          <a class="cta ghost" href={contactMailto}>Or email me</a>
        </div>
      </div>
      <figure class="hero-photo enter appear-300"><Picture src={heroPhoto} alt="Alan, who runs burningsuit, sitting outdoors and smiling" formats={["avif"]} fallbackFormat="webp" widths={[400, 600, 800]} sizes="(min-width: 62rem) 40vw, 100vw" quality={66} loading="eager" fetchpriority="high" /></figure>
    </div>
  </section>

  <div class="thread thread-snug" data-reveal-raw aria-hidden="true"></div>

  {/* Written out rather than a <Chapter>: the register-interest mailto must sit
      outside the reveal-gated prose (contact controls never wait on an entrance). */}
  <section class="chapter" aria-labelledby="way-in">
    <div class="wrap">
      <h2 class="section-head" id="way-in" data-reveal>Start with half a day</h2>
      <div class="prose" data-reveal>
        <p>The way in is <a href="/training/#agentic-101">{intro.title}</a> ({intro.length.toLowerCase()}), for anyone who builds in Power BI and wants to hand some of the building to an AI agent. The building decisions, that is, not the business ones.</p>
        {/* DRAFT for Alan: confirm the pilot wording; no price, date or seat numbers yet. */}
        <p>You book a seat for yourself, and the first one will be a pilot. A hands-on day and a course on modelling for agents are being written to follow it.</p>
      </div>
      <div class="routes"><a class="route" href="/training/#agentic-101">More about the 101</a><a class="route" href={interestHref}>Register your interest</a></div>
    </div>
  </section>

  <section class="chapter" aria-labelledby="courses">
    <div class="wrap">
      <h2 class="section-head" id="courses" data-reveal>The longer courses</h2>
      <div class="prose" data-reveal>
        <p>Every course runs on examples and a training dataset I've built for teaching. Nobody brings data, and there's nothing to prepare.</p>
      </div>
      <div class="doors">
        {courseDoors.map((door, i) => <DoorRow {...door} variant={i === 0 ? "lead" : "second"} index={i} />)}
      </div>
      <div class="routes"><a class="route" href="/training/">All the courses, and how they run</a></div>
    </div>
  </section>

  <Chapter id="consultancy" kicker="A course, or help with your own reporting?">
    <p>I keep the two apart on purpose. A course is for learning a skill, on material designed to teach it. Consultancy is for solving a particular problem of your own: a report that has to be delivered, a number that doesn't look right, a system you've taken over from someone else.</p>
    <div class="doors"><DoorRow {...consultancyDoor} /></div>
    <p>If you're not sure which you need, <a href="/hour/">tell me what your reporting can't do (yet)</a>. The first conversation is a free hour on a call.</p>
  </Chapter>

  <section class="chapter" aria-labelledby="in-practice">
    <div class="wrap">
      <h2 class="section-head" id="in-practice" data-reveal>Consultancy, in practice</h2>
      <ServiceRows rows={evidenceRows} />
      <Exhibit tab="Three systems, one model" caption="A museum's counters, tills and ticketing feed one shared model the team runs themselves.">
        <div class="exhibit-flow">
          <p>what the counters count</p>
          <p>what the tills take</p>
          <p>what the shop &amp; ticketing sell</p>
          <p class="model">one shared model</p>
        </div>
      </Exhibit>
      <div class="routes"><a class="route" href="/work/museum/">Read the museum story</a><a class="route" href="/work/">All four case studies</a></div>
    </div>
  </section>

  <StatementChapter label="AI will build whatever you ask. Someone still has to know what to ask for." lines={statementLines} linkHref="/writing/we-are-all-middle-management-now/" linkLabel="Read the essay" />
  <PhotoChapter />
  <AboutTeaser />
  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer"></div>
</BaseLayout>
