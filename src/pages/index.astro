---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiseHeading from "../components/RiseHeading.astro";
import ServiceRows from "../components/ServiceRows.astro";
import type { RowData } from "../components/ServiceRow.astro";
import PrinciplesChapter from "../components/PrinciplesChapter.astro";
import PhotoChapter from "../components/PhotoChapter.astro";
import StatementChapter from "../components/StatementChapter.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
import type { Line } from "../components/RiseHeading.astro";
import { Picture } from "astro:assets";
import heroPhoto from "../assets/photos/DSC08670-Edit.jpg";

const contactSubject = "Power BI & Fabric";
const contactMailto = `mailto:alan@burningsuit.co.uk?subject=${encodeURIComponent(contactSubject)}`;

const heroLabel = "power bi and fabric, done with you.";
const heroLines: Line[] = ["power bi & fabric,", { before: "done ", em: "with", after: " you." }];

const serviceRows: RowData[] = [
  {
    n: "01",
    href: "/power-bi/",
    title: { before: "power bi & fabric, done ", em: "with", after: " you" },
    body: "Embedded advisory, strategy and architecture review, and ongoing work inside Power BI and Fabric teams. You stay close to the work; I help your team feel like they've got it — so the know-how stays with you when I leave.",
    cta: "see how it works",
  },
  {
    n: "02",
    href: "/ai-fit-for-teams/",
    title: { before: "ai ", em: "fit", after: " for teams" },
    body: "Copilot and agents can already write the DAX, build the model, even draft the whole report — but 'can' doesn't mean 'should'. I help your team work out what to hand over, what to keep, and who checks what, so the work stays yours to own and verify.",
    cta: "see how it works",
  },
];

const principles = [
  {
    title: "the answers are yours",
    body: "I help your team reach the right answers for how you actually work, instead of arriving with mine. Understand your own models and data, and you can own them — and own what you hand to a tool.",
  },
  {
    title: "what not to automate",
    body: "Knowing what not to automate matters as much as knowing what to. As the tools take on more of the build, the discipline is choosing which decisions you let it make — and staying conscious of where you've made the call.",
  },
  {
    title: "mental models first",
    body: "AI literacy is a feel for how these tools think, and where they help your work or quietly mislead it. I go deep on that, then make it something your team can hold too.",
  },
];

const statementLines: Line[] = [
  "ai can make the things.",
  "the responsibility for them",
  { before: "stays with ", em: "you", after: "." },
];
---

<BaseLayout
  title="Power BI & Fabric advisory, done with you — burningsuit"
  description="Embedded Power BI and Fabric advisory, done with you — strategy, architecture review, and team capability — with a clear-eyed take on what AI means for how the work gets built."
  contactSubject={contactSubject}
>
  <Fragment slot="footer-invitation"
    >Tell me where Power BI or Fabric is getting stuck — the bottleneck, the model nobody
    quite trusts, the bit AI's about to change. If I can help, I'll tell you how; if I
    can't, I'll tell you that too. Replies come from me</Fragment
  >

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker hero-prompt">
          <span class="pre" aria-hidden="true">›</span><span class="kt"
            >power bi &amp; fabric advisory</span
          ><span class="cursor" aria-hidden="true"></span>
        </p>
        <RiseHeading as="h1" kind="hero" label={heroLabel} lines={heroLines} />
        <p class="lede enter appear-300">
          I help your team get more capable with Power BI and Fabric, and
          <strong>keep the work yours, even as AI takes on the typing</strong>.
        </p>
        <div class="cta-row enter appear-450">
          <a class="cta" href={contactMailto}>email me</a>
          <a class="cta ghost" href="#what">what i do</a>
        </div>
      </div>
      <figure class="hero-photo enter appear-300">
        <Picture
          src={heroPhoto}
          alt="Alan, who runs burningsuit, sitting outdoors and smiling"
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[400, 600, 800]}
          sizes="(min-width: 62rem) 40vw, 100vw"
          quality={66}
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter" aria-labelledby="what">
    <div class="wrap what">
      <div class="label">
        <h2 class="kicker meta" id="what" data-reveal>what i do</h2>
      </div>
      <div>
        <ServiceRows rows={serviceRows} />
        <p class="section-intro" data-reveal>
          A few of these in practice - a law firm's data team, a contact-centre lead, a
          university carbon model, a museum that ran on a whiteboard.
          <a class="u" href="/work/">see the work ▸</a>
        </p>
      </div>
    </div>
  </section>

  <PrinciplesChapter kicker="how i work" headingId="how" principles={principles} />

  <PhotoChapter />

  <StatementChapter
    label="ai can make the things. the responsibility for them stays with you."
    lines={statementLines}
  />

  <AboutTeaser />

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div id="talk" class="talk-spacer"></div>
</BaseLayout>
