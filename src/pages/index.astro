---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiseHeading from "../components/RiseHeading.astro";
import Chapter from "../components/Chapter.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Exhibit from "../components/Exhibit.astro";
import type { RowData } from "../components/ServiceRow.astro";
import StatementChapter from "../components/StatementChapter.astro";
import PhotoChapter from "../components/PhotoChapter.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
import BookCta from "../components/BookCta.astro";
import type { Line } from "../components/RiseHeading.astro";
import { Picture } from "astro:assets";
import heroPhoto from "../assets/photos/DSC08670-Edit.jpg";
import { mailtoFor } from "../config/site";

const contactSubject = "Power BI & Fabric";
const contactMailto = mailtoFor(contactSubject);
const heroLines: Line[] = ["Power BI your", { before: "team can ", em: "own", after: "." }];
const evidenceRows: RowData[] = [
  { href: "/work/contact-centre/", tab: "A national contact centre", title: { before: "She built the dashboard ", em: "herself", after: "." }, body: "A team lead had stalled when she tried Power BI on her own data. In one of our sessions, she reached for the right function before I got there - she recognised it from Excel.", cta: "Read the contact-centre story" },
  { href: "/work/law-firm/", tab: "An international law firm", title: { before: "They ", em: "own", after: " a system someone else built." }, body: "A consultancy built their Fabric system. I worked with the team while it was happening. By handover, they were tracing wrong numbers through the new stack and finding the likely cause themselves.", cta: "Read the law-firm story" },
];
const statementLines: Line[] = [
  "AI will build",
  "whatever you ask.",
  "Someone still has to",
  { before: "know what to ask ", em: "for", after: "." },
];
---

<BaseLayout title="Power BI your team can own - burningsuit" description="Alan Harman-Box works alongside teams on Power BI and Fabric. Find the help that fits your reporting, or bring the question to a free hour on a call." contactSubject={contactSubject}>
  <Fragment slot="footer-invitation">Tell me what your Power BI or Fabric team is wrestling with, and where you'd like it to get to. Replies come from me</Fragment>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <RiseHeading as="h1" kind="hero" label="Power BI your team can own." lines={heroLines} />
        <div class="hero-introduction enter appear-300">
          <p>I'm Alan. I've worked alongside teams on Power BI and Fabric for the last five years, and spent a decade in software before that.</p>
          <p class="hero-motivation">I don't just want your team to have a report that works. I want them to understand why it works, so they can question a number, or make changes with confidence.</p>
          <p class="hero-invitation">We can start with <a href="/hour/">a free hour</a> to talk through what you're working on.</p>
        </div>
        <BookCta src="home-hero" mailtoHref={contactMailto} variant="hero" />
      </div>
      <figure class="hero-photo enter appear-300"><Picture src={heroPhoto} alt="Alan, who runs burningsuit, sitting outdoors and smiling" formats={["avif"]} fallbackFormat="webp" widths={[400, 600, 800]} sizes="(min-width: 62rem) 40vw, 100vw" quality={66} loading="eager" fetchpriority="high" /></figure>
    </div>
  </section>

  <div class="thread thread-snug" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter" aria-labelledby="in-practice">
    <div class="wrap">
      <h2 class="section-head" id="in-practice" data-reveal>What that looks like in practice</h2>
      <ServiceRows rows={evidenceRows} />
      <Exhibit tab="Three systems, one model" caption="A museum's counters, tills and ticketing feed one shared model the team runs themselves.">
        <div class="exhibit-flow">
          <p>what the counters count</p>
          <p>what the tills take</p>
          <p>what the shop &amp; ticketing sell</p>
          <p class="model">one shared model</p>
        </div>
      </Exhibit>
      <div class="routes"><a class="route" href="/work/museum/">Read the museum story</a><a class="route" href="/work/">All four case studies</a></div>
    </div>
  </section>

  <Chapter id="situations" kicker="Help with the work in front of you">
    <p>Where we start depends on what your people need to be able to do next.</p>
    <ul class="routes routes-stack">
      <li><a class="route" href="/power-bi/#deliver">Build and change your reporting</a></li>
      <li><a class="route" href="/power-bi/#skills">Learn the why behind the how</a></li>
      <li><a class="route" href="/power-bi/#handover">Understand a system you inherited</a></li>
    </ul>
    <p>If you're the one responsible but not the one building it, you can bring your own questions: a proposal to sign off, a hire to make, whether the team is ready to take a system over. <a href="/power-bi/#second-opinion">I'll be the second opinion you'd otherwise have to do without.</a></p>
    <div class="routes"><a class="route" href="/hour/">Tell me what your reporting can't do (yet)</a></div>
  </Chapter>

  <StatementChapter label="AI will build whatever you ask. Someone still has to know what to ask for." lines={statementLines} linkHref="/writing/we-are-all-middle-management-now/" linkLabel="Read the essay" />
  <PhotoChapter />
  <AboutTeaser />
  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer"></div>
</BaseLayout>
