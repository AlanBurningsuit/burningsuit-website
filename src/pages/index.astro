---
/*
 * TEMPORARY placeholder — published to `main` only to prove the GitHub Actions
 * deploy pipeline (deploy.yml -> withastro/action -> deploy-pages -> apex) end
 * to end on the real domain. Self-contained (does NOT use BaseLayout) so it has
 * no nav links to the removed pages, while still carrying the <title>, meta
 * description, canonical, and a valid JSON-LD node that `npm run check:seo`
 * (the publish-readiness gate) requires. Reverted via the `legacy-site-backup`
 * tag once the deploy is confirmed.
 */
const canonical = "https://burningsuit.co.uk/";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "burningsuit",
  url: canonical,
});
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>burningsuit — updating</title>
    <meta
      name="description"
      content="burningsuit — embedded Power BI & Fabric advisory, done with you. The site is being updated; back shortly."
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/placeholder.css" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <main>
      <p class="mark">burningsuit</p>
      <p>we're updating the site — back shortly.</p>
      <p><a href="mailto:alan@burningsuit.co.uk">alan@burningsuit.co.uk</a></p>
    </main>
  </body>
</html>
