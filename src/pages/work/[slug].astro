---
/**
 * /work/<slug> — renders one entry of the `work` collection.
 *
 * The MDX body is authored against the case-study kit; the components are passed
 * to <Content> here so the .mdx files stay import-free. The gated testimonial is
 * rendered by CaseStudyLayout (from frontmatter), not from the body, so the gate
 * lives in one place.
 */
import { getCollection, render } from "astro:content";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import Chapter from "../../components/Chapter.astro";
import Snapshot from "../../components/Snapshot.astro";
import Offer from "../../components/Offer.astro";
import Aside from "../../components/Aside.astro";
import Exhibit from "../../components/Exhibit.astro";

export async function getStaticPaths() {
  const studies = await getCollection("work");
  return studies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudyLayout study={entry.data}>
  <Content components={{ Chapter, Snapshot, Offer, Aside, Exhibit }} />
</CaseStudyLayout>
