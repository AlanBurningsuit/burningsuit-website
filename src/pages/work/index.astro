---
/**
 * /work — the case-study index.
 *
 * A text-led page-hero that earns the anonymity (NDA work, told without logos,
 * detail turned up not down), then the four studies as carved "case file" tiles
 * built from the `work` collection (sorted by `order`) through ServiceRows — the
 * same cream-panel-as-link the homepage uses. Adding a study to the collection
 * adds a tile here automatically.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceRows from "../../components/ServiceRows.astro";
import type { RowData } from "../../components/ServiceRow.astro";

const contactSubject = "Power BI & Fabric";

const studies = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const rows: RowData[] = studies.map((s) => ({
  href: `/work/${s.id}/`,
  tab: "case file",
  title: s.data.heading,
  body: s.data.tileOutcome,
  cta: "read the full story",
}));
---

<BaseLayout
  title="Work — Power BI & Fabric case studies — burningsuit"
  description="Real Power BI and Fabric jobs: a law firm's data team, a contact-centre lead, a university carbon model, and a museum that ran on a whiteboard. Read the one that sounds like yours."
  contactSubject={contactSubject}
>
  <Fragment slot="footer-invitation"
    >If one of these sounds like where you are, tell me about it. If I can help, I'll
    tell you how; if I can't, I'll tell you that too</Fragment
  >

  <section class="page-hero" data-ground="aubergine">
    <div class="wrap">
      <p class="kicker meta enter">the work</p>
      <h1 class="enter appear-300">you might recognise one of these.</h1>
      <p class="lead enter appear-450">
        A bottleneck, a model nobody quite trusts, every report still done by hand.
        Read the one that sounds like yours.
      </p>
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter" data-ground="aubergine" aria-labelledby="cases">
    <div class="wrap what">
      <div class="label">
        <h2 class="kicker meta" id="cases" data-reveal>case files</h2>
      </div>
      <ServiceRows rows={rows} />
    </div>
  </section>

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer" data-ground="aubergine"></div>
</BaseLayout>
