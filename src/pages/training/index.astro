---
// Wording: ops site/training-page-copy.md. Its field labels, layout notes and annotations are not copy.
// The two starting points reuse the homepage's course entries (home.css); training.css holds this page's composition.
// Fundamentals and How I train are pending routes (src/config/pending-routes.mjs); 101 booking stays on its own page.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { itemListNode } from "../../lib/schema";
import TitleBand from "../../components/TitleBand.astro";
import PullQuote from "../../components/PullQuote.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import CourseEntry from "../../components/CourseEntry.astro";
import { STARTING_COURSES } from "../../config/starting-courses.mjs";
import Tracked from "../../components/Tracked.astro";
import { EVENTS } from "../../config/analytics.mjs";
import StudyLinks from "../../components/StudyLinks.astro";
import { ENQUIRY } from "../../config/enquiry.mjs";
import { loadTrainingPrices, trainingPriceCopy, PRICE_ON_REQUEST } from "../../lib/training-prices.mjs";
import "../../styles/home.css";
import "../../styles/training.css";

const { email } = ENQUIRY;
// Priced only when SHOW_TRAINING_PRICES=true; coaching, the private 101 and every unpriced fact keep "Price on request".
const priced = trainingPriceCopy(loadTrainingPrices());
const price = PRICE_ON_REQUEST;
// Priced output drops "On site or online": the price item already names both.
const privateFacts = (course: string) => priced
  ? ["Private, for your team", "Up to 8 people", course === "Power BI fundamentals" ? priced.trainingFundamentals : priced.specialists[course as keyof typeof priced.specialists]]
  : ["Private, for your team", "On site or online", "Up to 8 people", price];
const description = `Two places to start with Power BI, and two specialist courses for teams, with length, delivery and group size for each.${priced ? "" : " Price on request."}`;
const specialists = [
  { name: "DAX fundamentals", length: "1 day", href: "/training/dax-fundamentals/" },
  { name: "DAX deep dive", length: "2 days", href: "/training/dax-deep-dive/" },
];
// The four courses in the order the page lists them; each course page carries its own Course node.
const courses = [
  { name: "Power BI fundamentals", href: "/training/power-bi-fundamentals/" },
  { name: "Power BI with AI agents 101", href: "/training/power-bi-with-ai-agents-101/" },
  ...specialists,
];
const schema = [itemListNode({ pageUrl: new URL(Astro.url.pathname, Astro.site).href, name: "Power BI courses", items: courses.map((course) => ({ name: course.name, url: new URL(course.href, Astro.site).href })) })];
---
<BaseLayout
  title="Power BI courses | burningsuit"
  description={description}
  placeholder={false}
  schema={schema}
>
  <TitleBand heading={{ before: "Power BI ", em: "courses" }} />
  <div class="training-intro wrap">
    <p>If you're new to Power BI, start with Power BI fundamentals. If you've already built a report, Power BI with AI agents 101 shows you how to start working with an AI agent: a tool that reads a report's files, makes the changes you ask for and shows you what it did.</p>
    {priced && <p>{priced.trainingIntro}</p>}
  </div>

  <section class="starting-points" aria-labelledby="start-points-title">
    <div class="wrap">
      <h2 id="start-points-title">Two places to start</h2>
      <div class="start-list">
        <CourseEntry course={STARTING_COURSES.fundamentals}>
          <Fragment slot="facts">
            <li>2 days</li>
            {privateFacts("Power BI fundamentals").map((fact) => <li>{fact}</li>)}
          </Fragment>
          <a slot="actions" class="text-link" href="#contact">Ask about dates</a>
          <p class="private-ask">On your own? <a href="#coaching">Coaching starts wherever you are.</a></p>
        </CourseEntry>
        <CourseEntry course={STARTING_COURSES.agents101}>
          <Fragment slot="facts">
            <li>{STARTING_COURSES.agents101.mode}</li>
            <li><span class="fact-label">Public course:</span> <time datetime="2027-01-20">Wednesday 20 January 2027</time>, <span class="together">9:30am to 12:30pm UK time</span>, <span class="together">4 to 8 people</span></li>
            {priced && <li>{priced.publicSeat}</li>}
            <li>Also private, for your team</li>
            <li>{price}</li>
          </Fragment>
          <Fragment slot="actions">{priced && <Tracked event={EVENTS.bookSeatLink}><a class="text-link" href="/training/power-bi-with-ai-agents-101/#book-title">Book a seat</a></Tracked>}</Fragment>
          <p class="private-ask">Want this for your team? <a href={`mailto:${email}`}>Ask about a private course.</a></p>
        </CourseEntry>
      </div>
      <PullQuote quote="The analysts you've trained have made a huge difference. We're producing really good dashboards, and the force has been really positive about what's being delivered." cite="Corporate insights, a UK police force" />
    </div>
  </section>

  <section class="specialist-courses wrap" aria-labelledby="specialists-title">
    <div class="specialists-head">
      <h2 id="specialists-title">Want to dive deeper into Power BI?</h2>
      <p>Private courses for teams on calculations. The DAX deep dive's first day covers the same topics as DAX fundamentals, and its second day goes further.</p>
    </div>
    <div class="specialists-body">
      <ul class="specialist-rows" role="list">
        {specialists.map(({ name, length, href }) => (
          <li>
            {/* A course with its own page (DAX fundamentals, the DAX deep dive): its name and an outline link lead there. */}
            <h3>{href ? <a href={href}>{name}</a> : name}</h3>
            <ul class="facts dot-list">
              <li>{length}</li>
              {privateFacts(name).map((fact) => <li>{fact}</li>)}
            </ul>
            {href && <a class="text-link outline-link" href={href}>Read the course outline</a>}
            {name === "DAX deep dive" && <StudyLinks studies={["dax-deep-dive"]} />}
          </li>
        ))}
      </ul>
      <a class="text-link" href="#contact" aria-describedby="name-course">Ask about one of these</a>
      <p class="name-course" id="name-course">Name the course in your message.</p>
      <p class="not-sure">Not sure which fits? <a href="#contact">Tell me what you use Power BI for now, and I'll suggest where to start.</a></p>
    </div>
  </section>

  <section id="coaching" class="coaching wrap" aria-labelledby="coaching-title">
    <div class="specialists-head">
      <h2 id="coaching-title">Want to learn on your own work?</h2>
      <p>Coaching is for 1 to 3 people from the same organisation, ideally the same team, who want to learn Power BI on the work they actually do. I write a syllabus for the people taking part, and we work on your own data, or on example data I build to look like yours, with the problems you're stuck on.</p>
    </div>
    <div class="specialists-body">
      <ul class="specialist-rows" role="list">
        <li>
          <h3>Power BI coaching</h3>
          <ul class="facts dot-list">
            <li>4 to 8 weeks</li>
            <li>A two-hour session each week, with homework in between</li>
            <li>Up to 3 people from one organisation</li>
            <li>Online, or on site where it suits</li>
            <li>{price}</li>
          </ul>
        </li>
      </ul>
      <PullQuote quote="I'd never figured this out on my own." cite="A contact-centre team lead" />
      <a class="text-link" href="#contact" aria-describedby="mention-coaching">Ask about coaching</a>
      <p class="name-course" id="mention-coaching">Mention coaching in your message.</p>
      <StudyLinks studies={["contact-centre", "individual-power-bi-coaching"]} />
    </div>
  </section>

  <section class="training-teacher wrap" aria-labelledby="teacher-title">
    <h2 id="teacher-title">Who's teaching</h2>
    <div class="teacher-note">
      <p>I'm Alan Harman-Box. I've spent about five years working with organisations as they adopt Power BI, and about a decade in software delivery before that. So when a question leads down a useful rabbit hole, I can follow it and still bring you back to the course. I've taught Power BI fundamentals to about 300 people, and since 2021 people from about 80 organisations have learned with me.</p>
      <div class="course-actions">
        <a class="text-link" href="/training/how-i-train/">How I train</a>
        <a class="text-link" href="/about/">More about me</a>
        <a class="text-link" href="/work/">Case studies</a>
      </div>
    </div>
  </section>

  <EnquiryForm>
    <Fragment slot="heading">Ask about a course</Fragment>
    If you know which course you want, name it in your message. If you don't, tell me what you use Power BI for now and I'll suggest where to start.
  </EnquiryForm>
</BaseLayout>
