---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceRows from "../components/ServiceRows.astro";
import type { RowData } from "../components/ServiceRow.astro";
import { flags } from "../config/flags";

const aiDoor: RowData[] = [
  {
    n: "→",
    href: "/ai-fit-for-teams/",
    title: { before: "ai ", em: "fit", after: " for teams" },
    body: "AI agents can build your Power BI reports, write your DAX, structure your models. I've been using them seriously for over a year now and they're genuinely capable — and they will only get more so. But capable isn't the same as safe to rely on. Working out what that means for your team — what to hand over, what to keep, who checks what — is the other thing I do.",
  },
];

// "what i don't do" — the sheep-dip clause is gated (Alan's call); the rest ships.
const dontDo = flags.sheepDip
  ? "I don't run public courses any more, and I don't do sheep-dip training — people in a room for a day to tick a box. If the team's going to learn something, it'll be on your data, inside your actual problems, because that's where it sticks."
  : "I don't run public courses any more. If the team's going to learn something, it'll be on your data, inside your actual problems, because that's where it sticks.";
---

<BaseLayout
  title="power bi, done with you · burningsuit"
  description="Embedded advisory, strategy, and architecture review inside Power BI and Fabric teams. You do as much of the work as possible; I work out how to accelerate it — so the know-how stays with you."
>
  <Fragment slot="footer-invitation"
    >Tell me where Power BI is grinding — the bottleneck, the model nobody quite trusts. If I
    can help, I'll tell you how; if I can't, I'll tell you that too</Fragment
  >

  <section class="page-hero" data-ground="aubergine">
    <div class="wrap">
      <p class="kicker meta enter">power bi, done with you</p>
      <p class="lead enter appear-300">
        <strong
          >I've spent five years working with organisations adopting Power BI — long enough
          to have seen the pattern:</strong
        > a team gets the licences, builds the first reports, and <em>then</em> the difficult
        part starts. The one person who really knows the model becomes the bottleneck. Things
        break when anyone else touches them. The training course made sense until you tried it
        on your own data.
      </p>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="whatido">
    <div class="wrap">
      <p class="kicker meta" id="whatido" data-reveal>what i do</p>
      <p class="lead section-intro" data-reveal>
        You do as much of the work as possible; I work out how to <em>accelerate</em> it.
      </p>

      <div class="offer" data-reveal>
        <p class="meta tag">the lead offer</p>
        <h3>embedded advisory</h3>
        <p>
          The work I rate most highly: I join your team for a stretch — office hours,
          workshops, one-on-ones — working on your real problems, in your real workspace. It
          runs as a working relationship rather than a scheduled course, and over a few months
          the team gets steadily more confident handling it themselves.
        </p>
      </div>

      <div class="offer" data-reveal>
        <h3>strategy &amp; architecture review</h3>
        <p>
          Before anything gets built: what are we measuring, really? Is the model carrying the
          business logic it should? I'll tell you what it's going to cost and what you're going
          to get — including when the honest answer is that a Power BI model won't fix this.
        </p>
      </div>

      <div class="offer" data-reveal>
        <h3>build work, case by case</h3>
        <p>
          And if you have a specific, well-thought-through build in mind, ask — I take those on
          case by case.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="proof">
    <div class="wrap">
      <p class="kicker meta" id="proof" data-reveal>how it tends to go</p>
      <div class="proof" data-reveal>
        <p>
          One data team I work with — inside an international law firm — started from “fear of
          breaking”: production models nobody dared touch, external help needed for minor
          changes. A few months of working together, and they were running their own diagnostic
          sessions, tracing data lineage end to end, and challenging their vendor's deliverables
          with technical evidence they'd gathered themselves.
        </p>
        {
          flags.proofNamed && (
            <>
              <p class="attr meta">[client redacted]</p>
              <blockquote>
                “[quote redacted] the
                [quote redacted]”
                <cite class="meta">[attribution redacted]</cite>
              </blockquote>
            </>
          )
        }
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="dont">
    <div class="wrap prose">
      <p class="kicker meta" id="dont" data-reveal>what i don't do</p>
      <p data-reveal>{dontDo}</p>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="aidoor">
    <div class="wrap what">
      <p class="label kicker meta" id="aidoor" data-reveal>the other thing i do</p>
      <ServiceRows rows={aiDoor} />
    </div>
  </section>

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer" data-ground="aubergine"></div>
</BaseLayout>
