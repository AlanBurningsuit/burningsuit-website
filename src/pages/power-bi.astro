---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Aside from "../components/Aside.astro";
import RiseHeading from "../components/RiseHeading.astro";
import type { RowData } from "../components/ServiceRow.astro";
import type { Line } from "../components/RiseHeading.astro";
import { getEntry } from "astro:content";
import { Picture } from "astro:assets";
import pbiHero from "../assets/photos/DSC08846-Edit.jpg";
import BookCta from "../components/BookCta.astro";
import { mailtoFor } from "../config/site";

// The proof panel is the law-firm case study at teaser length. Its naming gate is
// the SAME `namePublished` the full /work/law-firm page uses, so the teaser and the
// page can never disagree about naming the client.
const lawFirm = await getEntry("work", "law-firm");
const lawFirmNamed = lawFirm?.data.namePublished ? lawFirm.data.named : undefined;

const contactSubject = "Power BI & Fabric — where it's stuck";
const contactMailto = mailtoFor(contactSubject);

// Same headline as the home hero; display grotesque, masked-rise, amber "with".
const heroLines: Line[] = ["power bi & fabric,", { before: "done ", em: "with", after: " you." }];

// The bridge to the AI page. The prose that used to sit above this card duplicated the
// hero's AI beat, so the card now carries the AI-pressure substance on its own.
const aiDoor: RowData[] = [
  {
    n: "→",
    href: "/ai-fit-for-teams/",
    title: { before: "ai ", em: "fit", after: " for teams" },
    body: "I've been building with AI agents seriously for over a year: genuinely capable, getting more so — but 'can' doesn't mean 'should'. Working out what to hand over, what to keep, and who checks what is the other thing I do, so the work stays yours to own and verify.",
    cta: "see ai fit for teams",
  },
];
---

<BaseLayout
  title="Power BI & Fabric advisory: embedded, review, capability — burningsuit"
  description="Embedded advisory, strategy and architecture review, and ongoing work inside Power BI and Fabric teams. You stay close to the work; I help your team feel like they've got it — so the know-how stays with you when I leave."
  contactSubject={contactSubject}
>
  <Fragment slot="footer-invitation"
    >Tell me where Power BI or Fabric is grinding — the bottleneck, the model nobody quite
    trusts, the bit AI's about to change. If I can help, I'll tell you how; if I can't,
    I'll tell you that too</Fragment
  >

  <section class="page-hero pbi-hero" data-ground="aubergine">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <RiseHeading as="h1" kind="hero" label="power bi and fabric, done with you." lines={heroLines} />
        <p class="lead enter appear-300">
          <strong>I've spent five years with teams adopting Power BI</strong>, long enough to
          know the pattern. A team gets the licences, builds the first reports, and
          <em>then</em> the difficult part starts:
        </p>
        <ul class="beats enter appear-450">
          <li>the one person who really knows the model becomes the bottleneck;</li>
          <li>things break when anyone else touches them;</li>
          <li>the training course made sense until you tried it on your own data.</li>
        </ul>
        <p class="lead enter appear-600">
          And there's always more: Fabric to move onto, Copilot writing DAX, agents building
          whole reports. The more the tools take on, the sharper one question gets: who owns
          the outcome?
        </p>
      </div>
      <figure class="hero-photo enter appear-300">
        <Picture
          src={pbiHero}
          alt="Alan in a checked shirt, leaning against a dark doorway in an alley, smiling"
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[400, 600, 800]}
          sizes="(min-width: 62rem) 36vw, 100vw"
          quality={70}
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter" data-ground="aubergine" aria-labelledby="whatido">
    <div class="wrap what">
      <h2 class="label kicker meta" id="whatido" data-reveal>what i do</h2>
      <div>
        <p class="lead" data-reveal>
          Whatever the shape of the work, the aim is the same: your team ends up more
          <em>capable</em> of owning it — with or without me.
        </p>

        <div class="offer offer-lead" data-reveal>
          <h3>embedded advisory</h3>
          <p>
            The work I rate most highly: I join your team for a stretch — office hours,
            workshops, one-on-ones — working on your real problems, in your real workspace,
            across Power BI and Fabric. It runs as a working relationship rather than a
            scheduled course, and over a few months the team gets steadily more confident
            handling it themselves.
          </p>
        </div>

        <div class="offer" data-reveal>
          <h3>strategy &amp; architecture review</h3>
          <p>
            Before anything gets built: what are we measuring, really? Is the model carrying
            the business logic it should? Does the move onto Fabric earn its keep, and where?
            I'll tell you what it's going to cost and what you're going to get — including when
            the honest answer is that a new model won't fix this.
          </p>
        </div>

        <div class="offer" data-reveal>
          <h3>ongoing work</h3>
          <p>
            The point of all of it is capability: a team that can build, change and verify the
            work without waiting on one person. The learning lands on your own data, inside
            your actual problems, because that's where it sticks — so when I leave, the know-how
            stays with your team.
          </p>
        </div>

        <div class="offer" data-reveal>
          <h3>build work, case by case</h3>
          <p>
            And if you have a specific, well-thought-through build in mind, ask — I take those on
            case by case.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="proof">
    <div class="wrap what">
      <div class="label">
        <h2 class="kicker meta" id="proof" data-reveal>how it tends to go</h2>
        <Aside data-reveal>data problems are people problems.</Aside>
      </div>
      <div>
        <div class="proof panel casefile" data-reveal>
          <span class="tab"><span class="sp" aria-hidden="true"></span>case file</span>
          <div class="body">
            <p class="src">a data team · international law firm</p>
            <p>
              One data team I work with — inside an international law firm — started from “fear of
              breaking”: production models nobody dared touch, external help needed for the
              smallest change, the whole thing resting on one or two people. A few months of
              working together, and they were running their own diagnostic sessions, tracing data
              lineage end to end, and challenging what their vendor delivered with technical
              evidence they'd gathered themselves. The reliance moved from a single expert to the
              team — which is also what makes them ready for what AI is starting to add to the job.
            </p>
            {
              lawFirmNamed && (
                <>
                  <p class="attr meta">{lawFirmNamed.client}</p>
                  <blockquote>
                    {lawFirmNamed.quote}
                    <cite class="meta">{lawFirmNamed.cite}</cite>
                  </blockquote>
                </>
              )
            }
            <p class="more">
              <a class="u" href="/work/law-firm/">read the full story ▸</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="engagement">
    <div class="wrap what">
      <h2 class="label kicker meta" id="engagement" data-reveal>the engagement, practically</h2>
      <div class="prose">
        <p data-reveal>
          Embedded advisory is ongoing, sized to your team and fits around the work you're
          already doing. Reviews are a fixed, shorter piece. I'll scope and price it with you up
          front, and we go month-to-month. The point is for your team to need me less over time.
        </p>
        <p data-reveal>
          Embedded advisory usually runs £3,000 to £6,000 a month, depending on the work.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-band" aria-label="book a call">
    <div class="wrap">
      <BookCta src="power-bi-proof" mailtoHref={contactMailto} reveal>
        Tell me where it's stuck, and I'll tell you whether I can help. 30 minutes, nothing to
        prepare.
      </BookCta>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="aipressure">
    <div class="wrap what">
      <h2 class="label kicker meta" id="aipressure" data-reveal>what ai's already touching</h2>
      <div>
        <ServiceRows rows={aiDoor} />
      </div>
    </div>
  </section>

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer" data-ground="aubergine"></div>
</BaseLayout>
