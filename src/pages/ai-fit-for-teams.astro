---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiseHeading from "../components/RiseHeading.astro";
import DoorRow from "../components/DoorRow.astro";
import Aside from "../components/Aside.astro";
import type { RowData } from "../components/ServiceRow.astro";
import type { Line } from "../components/RiseHeading.astro";
import BookCta from "../components/BookCta.astro";
import { mailtoFor } from "../config/site";

const contactSubject = "AI in Power BI & Fabric";
const contactMailto = mailtoFor(contactSubject);

const heroLines: Line[] = [{ before: "make ai ", em: "fit", after: " the team." }];
// Hero-left visual: the buyer's own sharpest worry as bare display type —
// static, signed, identical with and without JS. It pays off in the Copilot
// section below, so it's deliberately NOT repeated in the worry list.

const worries = [
  "We're paying for Copilot - what are we actually getting for it?",
  "It always sounds sure - so how do we know when it's right?",
  "What's safe to hand over, and what do we keep hold of ourselves?",
  "When we point it at our data, where does that data go?",
  "The ground keeps shifting - what do we even train for, or hire for?",
];

const movements = [
  {
    title: "a proper conversation with you",
    body: "It starts with what the team is for. What does it exist to do, and what are the signs - your signs - that the job is being done right? And honestly: how close are you to the nitty-gritty of how the work happens now?",
  },
  {
    title: "conversations with the team",
    body: "Then I sit with the team and get the real picture of how the work happens - what's frustrating, what's easy, what tools they're drawn to, what they want to be able to do. If AI's already in use, we open up what it's producing - the DAX it wrote, the model it built - and go through it together, where it holds up and where it doesn't.",
  },
  {
    title: "the fit map",
    body: "What you get is a map: how the team actually works today, the skills in the room, and a destination that holds up regardless of the tools.",
  },
];

const fitmap = [
  "what the team could be building faster, and what it could be building better",
  "what AI can't improve for you yet, and what it shouldn't touch at all",
  "a skills brief: what to hire for, what to develop, what to stop worrying about",
  "a 90-day decision list: do now · don't do yet · watch",
  "and the watch list is specific to your stack - if Microsoft brings a Fabric or Copilot feature out of beta, you'll already know what it makes feasible",
];

const door: RowData = {
  href: "/power-bi/",
  title: { before: "power bi & fabric, done ", em: "with", after: " you" },
  body: "When the work is specifically Power BI or Fabric - an architecture call, a model that needs owning, a team you'd like more self-sufficient - that's where to start. Embedded advisory, strategy and review, done with you.",
  cta: "see power bi, done with you",
};
---

<BaseLayout
  title="AI for Power BI & Fabric teams - burningsuit"
  description="Licensed for Copilot but it hasn't paid off? I help Power BI and Fabric teams get good at AI without handing over judgement - you leave with a fit map."
  contactSubject={contactSubject}
>
  <Fragment slot="footer-invitation"
    >Tell me how your Power BI or Fabric team works and what's nagging at you about AI, and
    I'll give you a straight, useful answer either way</Fragment
  >

  <section class="page-hero aifit-hero">
    <div class="wrap aifit-hero-grid">
      <div class="hero-copy">
        <p class="kicker meta enter">ai fit for teams</p>
        <RiseHeading as="h1" kind="hero" label="make ai fit the team." lines={heroLines} />
        <p class="lead enter appear-300">
          Your team's licensed for Copilot, and so far it hasn't quite paid off - some of it
          sitting idle, some of it writing DAX nobody can fully vouch for. What pays off is
          getting genuinely good with AI, without handing over your judgement - so a stretched
          team does more, and better. If that's roughly where you are, I help you work out what
          to hand over, what to keep, and who checks what: where it earns its place, and where it
          costs you more than it saves.
        </p>
      </div>
      {/* The buyer's own question as bare display type: claim (h1, right)
          faces question (left). Real line, no fabricated log/metrics. */}
      <RiseHeading
        as="p"
        kind="hero"
        class="hero-ask"
        label="who's checking the dax?"
        lines={[{ before: "who's ", em: "checking", after: " the dax?" }]}
        startIndex={2}
      />
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter" aria-labelledby="not-behind">
    <div class="wrap">
      <h2 class="section-head" id="not-behind" data-reveal>you're not behind</h2>
      <div class="prose">
        <p data-reveal>
          I won't walk in assuming your team's fallen behind on AI, or that the people are the
          problem. The teams I sit with usually know their own data and models inside out. What
          they're short of is an unhurried hour to work out which of these tools earns its place,
          and which is a demo that won't survive contact with their real reports.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" aria-labelledby="worries">
    <div class="wrap">
      <h2 class="section-head" id="worries" data-reveal>the questions teams bring me</h2>
      <ul class="qlist">
        {worries.map((q) => <li data-reveal>{q}</li>)}
      </ul>
    </div>
  </section>

  <section class="chapter" aria-labelledby="how-it-works">
    <div class="wrap">
      <h2 class="section-head" id="how-it-works" data-reveal>how it works</h2>
      <div>
        <p class="lead" data-reveal>
          It's a few days of my time, spread over two or three weeks and fitted around how the
          team already works. It starts with a conversation, and ends with a map you can act on.
        </p>
        <ol class="movements">
          {
            movements.map((m, i) => (
              <li class="movement" data-reveal>
                <span class="n" aria-hidden="true">{String(i + 1)}</span>
                <div>
                  <h3>{m.title}</h3>
                  <p>{m.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="chapter" aria-labelledby="fitmap">
    <div class="wrap what">
      <div class="label">
        <Aside data-reveal>the tools are just a means to an end.</Aside>
      </div>
      <div>
        <h2 class="section-head" id="fitmap" data-reveal>what's in the fit map</h2>
        <ul class="fitmap">
          {fitmap.map((item) => <li data-reveal>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="chapter" aria-labelledby="afterwards">
    <div class="wrap">
      <h2 class="section-head" id="afterwards" data-reveal>afterwards</h2>
      <div class="prose">
        <p data-reveal>
          The difference is in the decisions: you make them knowing where AI helps your team,
          where it hinders them - and how you'd know.
        </p>
        <p data-reveal>
          When the next Copilot upgrade or data agent lands, the team doesn't panic - they know
          what their work actually is, and it isn't the clicks. The aim, longer term, is a team that's
          resilient to the tools changing, more engaged with the work, and prouder of what they
          put out.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" aria-labelledby="copilot">
    <div class="wrap">
      <h2 class="section-head" id="copilot" data-reveal>already rolled out copilot?</h2>
      <div class="prose">
        <p data-reveal>
          Good - that's a start, but it's only licences so far. What changed once it landed: is
          anyone faster, are the outputs any better, and is someone reading the DAX back before
          it ships? The catch with Copilot is that it sounds just as sure about a model it's
          misread as one it's nailed. If those answers come back crisp - outputs demonstrably
          better, someone clearly checking the DAX - you're in good shape and you probably don't
          need me. If any of them made you hesitate, that's where I'd start.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" aria-labelledby="belief">
    <div class="wrap">
      <h2 class="section-head" id="belief" data-reveal>what it comes down to</h2>
      <div>
        <p class="belief" data-reveal>
          Every piece of work is a stack of decisions. Hand a problem to AI without naming those
          decisions, and it makes them for you - and a tool can't take <em>responsibility</em>
          for a decision.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-band" aria-label="book a call">
    <div class="wrap">
      <BookCta src="ai-fit" mailtoHref={contactMailto} reveal>
        30 minutes, nothing to prepare.
      </BookCta>
    </div>
  </section>

  <section class="chapter" aria-labelledby="door">
    <div class="wrap">
      <h2 class="section-head" id="door" data-reveal>the main work</h2>
      <DoorRow {...door} variant="second" index={1} />
    </div>
  </section>

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer"></div>
</BaseLayout>
