---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiseHeading from "../components/RiseHeading.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Aside from "../components/Aside.astro";
import type { RowData } from "../components/ServiceRow.astro";
import type { Line } from "../components/RiseHeading.astro";

const heroLines: Line[] = [{ before: "make ai ", em: "fit", after: " the team." }];

const worries = [
  "Is the team actually getting much out of AI?",
  "Is there more you could be doing — or less?",
  "Is your data going somewhere it shouldn't?",
  "Are you being handed work nobody can vouch for?",
  "Who's checking the DAX?",
];

const movements = [
  {
    title: "a proper conversation with you",
    body: "It starts with what the team is for. What does it exist to do, and what are the signs — your signs — that the job is being done right? And honestly: how close are you to the nitty-gritty of how the work happens now?",
  },
  {
    title: "conversations with the team",
    body: "Then I sit with the team and get the real picture of how the work actually happens — what's frustrating, what's easy, what tools they're drawn to, what they want to be able to do. If AI is already in use, we look together at what it's really producing and how it's holding up.",
  },
  {
    title: "the fit map",
    body: "What you get is a map: how the team actually works today, the skills in the room, and a destination that holds up regardless of the tools. The tools are just a means to an end.",
  },
];

const fitmap = [
  "what the team could be doing faster, and what it could be doing better",
  "what AI can't improve for you yet, and what it shouldn't touch at all",
  "a skills brief: what to hire for, what to develop, what to stop worrying about",
  "a 90-day decision list: do now · don't do yet · watch",
  "and the watch list is specific to your stack — if Microsoft brings a feature out of beta, you'll already know what it makes feasible",
];

const door: RowData[] = [
  {
    n: "→",
    href: "/power-bi/",
    title: { before: "power bi, done ", em: "with", after: " you" },
    body: "When the work is specifically Power BI — the bottleneck, the model nobody quite trusts, the architecture question — that's its own page. Strategy, review, and embedded advisory, done with you.",
  },
];
---

<BaseLayout
  title="ai fit for teams · burningsuit"
  description="A short, deliberate piece of work: where AI helps your team, where it might be making things worse, and which decisions should stay yours. You leave with a fit map."
>
  <Fragment slot="footer-invitation"
    >Tell me how your team works and what's nagging at you, and I'll give you a straight,
    useful answer either way</Fragment
  >

  <section class="page-hero" data-ground="aubergine">
    <div class="wrap">
      <p class="kicker meta enter">ai fit for teams</p>
      <RiseHeading as="h1" kind="hero" label="make ai fit the team." lines={heroLines} />
      <p class="lead enter appear-300">
        AI readiness asks how to make your team ready for the tools. I think that's the
        wrong direction — the tools should fit the team. AI fit is making that happen
        deliberately: working out where AI helps your team, where it might be making things
        worse, and which decisions should stay yours — without promising you 10x speed-ups.
      </p>
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter" data-ground="aubergine" aria-labelledby="worries">
    <div class="wrap what">
      <h2 class="label kicker meta" id="worries" data-reveal>the questions that tend to be in the room</h2>
      <div>
        <ul class="qlist">
          {worries.map((q) => <li data-reveal>{q}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="how-it-works">
    <div class="wrap what">
      <h2 class="label kicker meta" id="how-it-works" data-reveal>how it works</h2>
      <div>
        <ol class="movements">
          {
            movements.map((m, i) => (
              <li class="movement" data-reveal>
                <span class="n" aria-hidden="true">{String(i + 1)}</span>
                <div>
                  <h3>{m.title}</h3>
                  <p>{m.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="fitmap">
    <div class="wrap what">
      <div class="label">
        <h2 class="kicker meta" id="fitmap" data-reveal>what's in the fit map</h2>
        <Aside data-reveal>the tools are just a means to an end.</Aside>
      </div>
      <div>
        <ul class="fitmap">
          {fitmap.map((item) => <li data-reveal>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="afterwards">
    <div class="wrap what">
      <div class="label">
        <h2 class="kicker meta" id="afterwards" data-reveal>afterwards</h2>
        <Aside data-reveal>i don't have a thermometer up here — i don't want to know.</Aside>
      </div>
      <div class="prose">
        <p data-reveal>
          The difference is in the decisions: you make them knowing where AI helps your team,
          where it hinders them — and how you'd know.
        </p>
        <p data-reveal>
          When the next big model launch lands, the team doesn't panic — they know what their
          work actually is, and it isn't the clicks. The work isn't the output; it's
          everything else around it. The aim, longer term, is a team that's resilient to the
          tools changing, more engaged with the work, and prouder of it.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="engagement">
    <div class="wrap what">
      <h2 class="label kicker meta" id="engagement" data-reveal>the engagement, practically</h2>
      <div class="prose">
        <p data-reveal>
          A few days of my time, spread over two or three weeks, fitted around the team's
          actual work. It starts with a conversation.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="copilot">
    <div class="wrap what">
      <h2 class="label kicker meta" id="copilot" data-reveal>already rolled out copilot?</h2>
      <div class="prose">
        <p data-reveal>
          Good — that's a start, but it's only licences. How is it being used? Is anyone
          faster? Have the outputs improved? Who's checking what it writes? If those questions
          are easy to answer, you don't need me. If they're not, that's what the fit map is
          for.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="belief">
    <div class="wrap what">
      <h2 class="label kicker meta" id="belief" data-reveal>the one belief underneath</h2>
      <div>
        <p class="belief" data-reveal>
          Every piece of work is a stack of decisions. Hand a problem to AI without specifying
          them, and it makes them for you — and a tool can't take <em>responsibility</em> for a
          decision.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter" data-ground="aubergine" aria-labelledby="door">
    <div class="wrap what">
      <h2 class="label kicker meta" id="door" data-reveal>the other thing i do</h2>
      <ServiceRows rows={door} />
    </div>
  </section>

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer" data-ground="aubergine"></div>
</BaseLayout>
