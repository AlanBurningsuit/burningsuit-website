---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiseHeading from "../components/RiseHeading.astro";
import Chapter from "../components/Chapter.astro";
import Aside from "../components/Aside.astro";
import type { Line } from "../components/RiseHeading.astro";
import BookCta from "../components/BookCta.astro";
import { mailtoFor } from "../config/site";

const contactSubject = "AI in Power BI & Fabric";
const contactMailto = mailtoFor(contactSubject);
const heroLines: Line[] = [{ before: "Make AI ", em: "fit", after: " the team." }];
const worries = [
  "We're paying for Copilot - what are we actually getting for it?",
  "It always sounds sure - so how do we know when it's right?",
  "What's safe to hand over, and what do we keep hold of ourselves?",
  "When we point it at our data, where does that data go?",
  "The ground keeps shifting - what do we even train for, or hire for?",
];
const movements = [
  { title: "A conversation with you", body: "It starts with what the team is for. What does it need to do, what would make that job easier, and how would you know the work had improved? We also look at the decisions you're being asked to make about tools, skills and cost." },
  { title: "Conversations with the team", body: "Then I sit with the team to understand how the work happens: what's frustrating, what's easy, which tools they use and what they want to be able to do. If AI's already in use, we look at what it's producing and how people check it." },
  { title: "The fit map", body: "I bring those conversations together into a map of where AI could help, the checks it would need and the skills the team would need to use it. You leave with a short list of decisions and next steps." },
];
const fitmap = [
  { label: "Where AI could help", body: "Tasks it could make faster or better, and how we'd check the difference" },
  { label: "What should wait", body: "Work it can't improve for you yet, and decisions your people need to keep hold of" },
  { label: "The skills brief", body: "What to develop in the team, what to hire for, and what to stop worrying about" },
  { label: "The 90-day decision list", body: "What to try now, what to defer and what to watch" },
  { label: "The watch list", body: "Changes in your tools worth revisiting, and the questions to ask when they arrive" },
];
---

<BaseLayout title="AI Fit for Teams - decisions and practical next steps - burningsuit" description="A two-to-three-week decision project with Alan Harman-Box: where AI could help your team, what should wait, and what skills and checks you need." ogImage="/social/linkedin-ai-fit.png" ogImageAlt="Make AI fit the team, beside a field-notebook decision map" ogImageWidth={1200} ogImageHeight={627} contactSubject={contactSubject}>
  <Fragment slot="footer-invitation">Tell me how your Power BI or Fabric team works and what's nagging at you about AI, and I'll give you a straight, useful answer either way</Fragment>

  <section class="page-hero aifit-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <RiseHeading as="h1" kind="hero" label="Make AI fit the team." lines={heroLines} />
        <RiseHeading as="p" kind="hero" class="hero-ask" label="Who's checking the DAX?" lines={[{ before: "Who's ", em: "checking", after: " the DAX?" }]} startIndex={1} />
        <p class="lead enter appear-450">AI Fit for Teams is a two-to-three-week decision project. We work out where AI could help your team, what should wait and how you'd judge the results. You leave with a <strong>fit map</strong> you can act on.</p>
      </div>
      <figure class="fitmap-doc enter appear-300" aria-label="The fit map">
        <span class="tab"><span class="sp" aria-hidden="true"></span>The fit map</span>
        <ol class="fitmap">{fitmap.map((item) => <li><span class="fm-label">{item.label}</span><p>{item.body}</p></li>)}</ol>
      </figure>
    </div>
  </section>

  <div class="thread" data-reveal-raw aria-hidden="true"></div>

  <section class="chapter band-2" aria-labelledby="how-it-works">
    <div class="wrap what">
      <h2 class="section-head" id="how-it-works" data-reveal>How it works</h2>
      <div class="label"><Aside data-reveal>A good chunk of it is knowing what to stop worrying about.</Aside></div>
      <div>
        <p class="lead" data-reveal>I'm Alan Harman-Box. I work with you and your team around the normal working week, with conversations followed by time for me to work through what I've heard.</p>
        <ol class="movements">{movements.map((movement, i) => <li class="movement" data-reveal><span class="n" aria-hidden="true">{i + 1}</span><div><h3>{movement.title}</h3><p>{movement.body}</p></div></li>)}</ol>
      </div>
    </div>
  </section>

  <section class="chapter" aria-labelledby="worries">
    <div class="wrap"><h2 class="section-head" id="worries" data-reveal>The questions teams bring me</h2><ul class="qlist">{worries.map((question) => <li data-reveal>{question}</li>)}</ul></div>
  </section>

  <Chapter id="afterwards" kicker="What happens afterwards?">
    <p>The fit map is yours to use. You can take the decisions and skills brief forward internally, or we can talk about help putting them into practice. AI Fit doesn't commit you to ongoing work.</p>
    <p>The map gives you questions to return to as the tools change: does this help with a task the team needs to do, what does it cost, and can someone check the result?</p>
  </Chapter>

  <Chapter id="copilot" kicker="Already have Copilot and want help using it?">
    <p>If you know what you want to try, you can come straight to practical support. We use the <a class="u" href="/power-bi/#practical-ai">Power BI working relationship</a>: workshops to try useful tasks and learn how to check the output, with office hours and email for questions that come up between sessions.</p>
    <p>Copilot in Power BI can help write DAX queries and create report pages. That gives us something useful to work with, but the team still needs to review the calculations and check that the report answers the intended question. Microsoft's <a class="u" href="https://learn.microsoft.com/en-us/power-bi/create-reports/copilot-introduction">Copilot overview</a> describes the available features and the capacity, admin and regional requirements.</p>
    <p>We check which Copilot product your team has access to before planning the work. A Copilot licence elsewhere doesn't by itself make Copilot in Power BI available.</p>
  </Chapter>

  <section class="cta-band" aria-label="Book an hour"><div class="wrap"><BookCta src="ai-fit" mailtoHref={contactMailto}>Tell me what you're trying to decide. We can talk it through in an hour; there's nothing to prepare.</BookCta></div></section>

  <div class="thread thread-end" data-reveal-raw aria-hidden="true"></div>
  <div class="talk-spacer"></div>
</BaseLayout>
