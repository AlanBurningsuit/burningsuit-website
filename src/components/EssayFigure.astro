---
/** Static, accessible adaptations of the diagrams in Alan's supplied talk. */
import agentWide from "../assets/diagrams/agent-system-wide.svg?url";
import agentNarrow from "../assets/diagrams/agent-system-narrow.svg?url";
import validationWide from "../assets/diagrams/visual-validation-wide.svg?url";
import validationNarrow from "../assets/diagrams/visual-validation-narrow.svg?url";
import delegationWide from "../assets/diagrams/delegation-wide.svg?url";
import delegationNarrow from "../assets/diagrams/delegation-narrow.svg?url";
import experienceWide from "../assets/diagrams/domain-experience-wide.svg?url";
import experienceNarrow from "../assets/diagrams/domain-experience-narrow.svg?url";
interface Props {
  kind: "agent" | "validation" | "delegation" | "experience";
}
const { kind } = Astro.props;
const figures = {
  agent: { number: 1, title: "The agentic system", caption: "The harness runs the requested tool and returns its result to the model's context." },
  validation: { number: 2, title: "The visual validation loop", caption: "The screenshot returns to the agent, which checks the result and can revise the report." },
  delegation: { number: 3, title: "The vibe zone", caption: "As the consequences of failure grow, make more of the decisions yourself." },
  experience: { number: 4, title: "Domain experience", caption: "Less experience makes it harder to judge the agent's decisions. The slope steepens." },
};
const figure = figures[kind];
const id = `essay-figure-${kind}`;
const diagrams = {
  agent: { wide: agentWide, narrow: agentNarrow, wideWidth: 936, wideHeight: 892, width: 584, height: 1233, alt: "Context is shown as a chat transcript: system prompt, user message, agent message, then tool result. The model reads this context and either replies to you or requests a tool. The harness runs the tool, and its result returns into context for the next response." },
  validation: { wide: validationWide, narrow: validationNarrow, wideWidth: 943, wideHeight: 538, width: 588, height: 1163, alt: "A loop: the agent updates the report files, commits and pushes them, and syncs the Fabric workspace. The report pages are requested through the API. Playwright saves a screenshot, which returns to the agent's context. The agent checks the image and can revise the report, starting the loop again." },
  delegation: { wide: delegationWide, narrow: delegationNarrow, wideWidth: 910, wideHeight: 625, width: 570, height: 625, alt: "A conceptual chart with consequence of failure increasing to the right and decisions delegated increasing upwards. A descending line separates the safer region below from the region of risk above. Higher consequences call for fewer delegated decisions. These are qualitative relationships, not measured thresholds." },
  experience: { wide: experienceWide, narrow: experienceNarrow, wideWidth: 910, wideHeight: 665, width: 570, height: 665, alt: "A conceptual comparison of two descending lines on the same axes. The dashed cream line represents more domain experience. The solid amber line for less experience falls more steeply, reducing the space for delegation as consequences increase. These are qualitative relationships, not measured thresholds." },
};
const diagram = diagrams[kind];
---

<figure class="essay-figure" aria-labelledby={`${id}-caption`}>
  <div class="essay-figure-heading" aria-hidden="true"><span>Figure {figure.number}</span><strong>{figure.title}</strong></div>

  <picture class="essay-diagram">
    <source media="(min-width: 48rem)" srcset={diagram.wide} width={diagram.wideWidth} height={diagram.wideHeight} />
    <img src={diagram.narrow} width={diagram.width} height={diagram.height} loading="lazy" decoding="async" alt={diagram.alt} />
  </picture>

  <figcaption id={`${id}-caption`}><span class="sr-only">Figure {figure.number}: {figure.title}. </span>{figure.caption}</figcaption>
</figure>
