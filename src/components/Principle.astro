---
/**
 * One principle in the magenta "how i work" chapter. A drawn rule, a Manrope
 * sub-head, and a line of body. Reveal + draw are staggered by `index`.
 */
interface Props {
  title: string;
  body: string;
  index?: number;
}
const { title, body, index = 0 } = Astro.props;
---
<div class:list={["principle", `stagger-${index}`]} data-reveal>
  <hr class:list={["rule", `stagger-${index}`]} data-reveal-raw />
  <h3>{title}</h3>
  <p>{body}</p>
</div>
