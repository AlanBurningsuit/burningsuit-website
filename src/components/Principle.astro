---
/**
 * One principle in the homepage "how i work" spine. These are three PARALLEL
 * principles, NOT sequential steps, so they carry no 01/02/03 numerals
 * (numbering would imply an order that isn't there). A Mona-600 title + an
 * fg-dim body; the hairline-separated list styling (.principle) is in app.css.
 */
interface Props {
  title: string;
  body: string;
}
const { title, body } = Astro.props;
---
<div class="principle" data-reveal>
  <h3>{title}</h3>
  <p>{body}</p>
</div>
