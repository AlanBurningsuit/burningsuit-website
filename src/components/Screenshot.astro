---
// A screenshot in a Writing post, from src/assets/writing/<post>/. Optimised to WebP at the reading column's width
// and twice that for sharp screens, never wider than the source; lazy-loaded, with its width and height set. `enlarge`
// wraps it in a plain link to the full-size source file, so a phone reader can open it full size.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Props { src: string; alt: string; enlarge?: boolean }
const { src, alt, enlarge = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/writing/**/*.png", { eager: true });
const image = files[`../assets/writing/${src}`]?.default;
if (!image) throw new Error(`Missing screenshot: ${src}`);
const column = 760;
const widths = [...new Set([Math.min(image.width, 400), Math.min(image.width, column), Math.min(image.width, column * 2)])];
const shot = { src: image, alt, widths, sizes: `(max-width: ${column + 44}px) calc(100vw - 44px), ${Math.min(image.width, column)}px`, format: "webp", quality: 90, loading: "lazy", decoding: "async" } as const;
---
<figure class="screenshot">
  {enlarge ? <a class="screenshot-enlarge" href={image.src}><Image {...shot} /><span class="sr-only"> (opens the full-size image)</span></a> : <Image {...shot} />}
</figure>
