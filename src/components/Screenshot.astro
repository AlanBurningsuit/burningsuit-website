---
// A screenshot in an archive post, from src/assets/writing/<post>/. Optimised to WebP at the reading column's width
// and twice that for sharp screens, never wider than the source; lazy-loaded, with its width and height set.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Props { src: string; alt: string }
const { src, alt } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/writing/**/*.png", { eager: true });
const image = files[`../assets/writing/${src}`]?.default;
if (!image) throw new Error(`Missing screenshot: ${src}`);
const column = 760;
const widths = [...new Set([Math.min(image.width, 400), Math.min(image.width, column), Math.min(image.width, column * 2)])];
---
<figure class="screenshot">
  <Image src={image} alt={alt} widths={widths} sizes={`(max-width: ${column + 44}px) calc(100vw - 44px), ${Math.min(image.width, column)}px`} format="webp" quality={90} loading="lazy" decoding="async" />
</figure>
