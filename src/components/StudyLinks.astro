---
import { getEntry } from "astro:content";
import { headingText } from "../lib/study-heading";
interface Props { studies: string[] }
const entries = await Promise.all(Astro.props.studies.map(async (id) => {
  const entry = await getEntry("work", id);
  if (!entry) throw new Error(`Missing study link destination: ${id}`);
  const { heading, linkLabel } = entry.data;
  return { id, label: linkLabel ?? headingText(heading) };
}));
---
<div class="study-evidence">
  <p class="study-evidence-label">{entries.length === 1 ? "Case study" : "Case studies"}</p>
  <ul class="study-links" role="list">
    {entries.map(({ id, label }) => <li><a href={`/work/${id}/`}>{label}</a></li>)}
  </ul>
</div>
