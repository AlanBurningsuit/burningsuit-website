---
/**
 * The permission-gated testimonial on a case-study page. The section and its
 * named content render only when namedTier() returns a permitted named block;
 * an anonymised study emits nothing here. Keep that decision in namedTier().
 */
import type { CollectionEntry } from "astro:content";
import { namedTier } from "../lib/named";

interface Props {
  study: CollectionEntry<"work">["data"];
}
const { study } = Astro.props;
const named = namedTier(study);
---

{
  named && (
    <section class="chapter" aria-labelledby="words">
      <div class="wrap">
        <h2 class="section-head" id="words" data-reveal>In their words</h2>
        <div class="proof panel casefile" data-reveal>
          <span class="tab"><span class="sp" aria-hidden="true"></span>Case study</span>
          <div class="body">
            {study.descriptor && <p class="src">{study.descriptor}</p>}
            <p class="attr meta">{named.client}</p>
            <blockquote>
              {named.quote}
              <cite class="meta">{named.cite}</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>
  )
}
