---
/**
 * The gated testimonial — the "in their words" section on a case-study page.
 *
 * Rendered by CaseStudyLayout (NOT from the MDX body). The section renders
 * ONLY when the study's named tier exists — while `namePublished` is false
 * (the anonymised default), nothing is emitted, so view-source can't leak a
 * PERMISSION-PENDING quote. The whole case-study page is the anonymised
 * proof; this section is the upgrade that appears once written permission
 * lands.
 *
 * The panel skeleton + the gated quote block live in CasefilePanel.astro;
 * the gate expression itself is src/lib/named.ts `namedTier()` — the one
 * audited place, shared with the /power-bi teaser and the homepage proof line.
 */
import type { CollectionEntry } from "astro:content";
import CasefilePanel from "./CasefilePanel.astro";
import { namedTier } from "../lib/named";

interface Props {
  study: CollectionEntry<"work">["data"];
}
const { study } = Astro.props;
const named = namedTier(study);
---

{
  named && (
    <section class="chapter" aria-labelledby="words">
      <div class="wrap">
        <h2 class="section-head" id="words" data-reveal>
          in their words
        </h2>
        <CasefilePanel study={study} />
      </div>
    </section>
  )
}
