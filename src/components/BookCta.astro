---
/**
 * The conversion CTA primitive, used at the page's intent peaks.
 *
 * variant="hero"    — two buttons in a row (primary book + ghost email), left,
 *                     inside the hero grid; positioned by `.hero .cta-row`.
 * variant="section" — the page's ACTION as a calm, full-width CENTRED invitation:
 *                     a de-risk line, ONE primary "book a call" button, and a
 *                     "prefer to write? email me" text link that gives email
 *                     equal standing as a path. Rendered inside the page's single
 *                     full-bleed band: <section class="cta-band"><div class="wrap">
 *                     <BookCta …> — the recessed "act here" beat between chapters
 *                     (see .cta-band in app.css), not buttons dropped into the
 *                     reading prose.
 *
 * The booking link is external (new tab); a top-level navigation needs no CSP
 * change. The default slot is the de-risk / context microcopy for this placement.
 */
import { bookingHref } from "../config/site";

interface Props {
  /** Placement id → ?utm_content= for attribution in Cal. */
  src: string;
  /** The page's mailto (with optional prefilled subject). */
  mailtoHref: string;
  label?: string;
  emailLabel?: string;
  variant?: "hero" | "section";
}
const {
  src,
  mailtoHref,
  label = "Book a 30-minute call",
  emailLabel,
  variant = "section",
} = Astro.props;
const hasNote = Astro.slots.has("default");
const bookHref = bookingHref(src);
// Email is a real second path, not an afterthought: the section variant labels
// it as a deliberate clause; the hero keeps a short ghost-button label.
const resolvedEmailLabel = emailLabel ?? (variant === "hero" ? "Or email me" : "prefer to write? email me");
---
{
  variant === "hero" ? (
    <div class="cta-row">
      <a class="cta" href={bookHref} target="_blank" rel="noopener noreferrer">
        {label}
      </a>
      <a class="cta ghost" href={mailtoHref}>
        {resolvedEmailLabel}
      </a>
    </div>
  ) : (
    <div class="cta-invite">
      {hasNote && (
        <p class="cta-note">
          <slot />
        </p>
      )}
      <a class="cta" href={bookHref} target="_blank" rel="noopener noreferrer">
        {label}
      </a>
      <a class="u cta-email" href={mailtoHref}>
        {resolvedEmailLabel}
      </a>
    </div>
  )
}
