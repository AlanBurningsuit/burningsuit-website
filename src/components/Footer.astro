---
/**
 * The basement: main scrolls up off this fixed footer to reveal the "let's talk"
 * close — the invitation line + face chip, then the two contact actions side by
 * side (primary "book a 30-minute call", ghost "email me", as in the hero), the
 * plain © line, and the full-width lockup signing the page.
 *
 * The invitation line is a named slot so each page can supply its own CTA copy
 * while keeping the chip + period consistent. Default = the homepage line.
 */
import FaceChip from "./FaceChip.astro";
import { commitHash } from "../lib/commit";
import { bookingHref } from "../config/site";
interface Props {
  /** The mailto (with optional prefilled ?subject=) built per-page in
   *  BaseLayout; defaults to a bare mailto. */
  mailtoHref?: string;
}
const { mailtoHref = "mailto:alan@burningsuit.co.uk" } = Astro.props;
---
<footer aria-labelledby="talk-h">
  <div class="wrap outro">
    <h2 id="talk-h">let's <em>talk</em>.</h2>
    <p class="sub">
      <slot name="invitation"
        >Tell me what your team is wrestling with. Replies come from me</slot
      > <FaceChip loading="lazy" />.
    </p>
    <div class="cta-row cta-footer">
      <a class="cta" href={bookingHref("footer")} target="_blank" rel="noopener noreferrer"
        >book a 30-minute call</a
      >
      <a class="cta ghost" href={mailtoHref}>email me</a>
    </div>
    <div class="foot-meta meta">
      <span>local time — <span id="clock2">gmt</span></span>
      <a class="u" href="/colophon/">build <span id="commit">{commitHash}</span> ↗</a>
    </div>
    <p class="legal">
      burningsuit ltd is a limited company registered in england &amp; wales&NewLine;registered number: 05738130 &middot; registered office: the courtyard, shoreham road, upper beeding, west sussex, BN44 3TN &middot; &copy; 2026{
      }
    </p>
  </div>
  <div class="lockup">
    <img src="/logos/burningsuit-on-green.svg" alt="burningsuit" width="285" height="52" />
  </div>
</footer>
