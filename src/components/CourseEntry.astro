---
// One starting course as Home and Training introduce it. The shared wording comes from src/config/starting-courses.mjs.
// Slots: `facts` takes the page's own <li> items; `deciding` what follows the prerequisite inside the facts block;
// `actions` the links after "Read the course outline"; the default slot what follows the links.
// `prereq` can be overridden while a page's wording still differs from the shared one.
interface Props {
  course: { id: string; fit: string; title: string; href: string; summary: string; prereq: string };
  prereq?: string;
}
const { course, prereq = course.prereq } = Astro.props;
---
<article class="course" aria-labelledby={course.id}>
  <p class="course-fit">{course.fit}</p>
  <h3 id={course.id}><a href={course.href}>{course.title}</a></h3>
  <p>{course.summary}</p>
  <div class="deciding">
    <ul class="facts dot-list"><slot name="facts" /></ul>
    <p class="prereq">{prereq}</p>
    <slot name="deciding" />
  </div>
  <div class="course-actions">
    <a class="text-link" href={course.href}>Read the course outline</a>
    <slot name="actions" />
  </div>
  <slot />
</article>
