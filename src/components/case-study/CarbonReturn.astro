---
// The study's way back to its offer: one paragraph beside its onward links.
import Tracked from "../Tracked.astro";
import { EVENTS } from "../../config/analytics.mjs";
interface Props { links: { text: string; href: string }[] }
const { links } = Astro.props;
---
<div class="case-return">
  <div class="wrap case-return-inner">
    <div class="case-return-copy"><slot /></div>
    <ul class="case-return-links" role="list">
      {links.map(({ href, text }) => <li>{href === "/call/" ? <Tracked event={EVENTS.bookCallLink}><a class="text-link" href={href}>{text}</a></Tracked> : <a class="text-link" href={href}>{text}</a>}</li>)}
    </ul>
  </div>
</div>
