---
// A study's one piece of evidence, marked by the amber evidence rule: the quote, who said it and the figures as plain text.
interface Props { quote: string; attribution: string; figures?: string }
const { quote, attribution, figures } = Astro.props;
---
<div class="wrap">
  <figure class="case-evidence evidence-rule">
    <blockquote><p>{quote}</p></blockquote>
    <figcaption class="case-attribution">{attribution}</figcaption>
    {figures && <p class="case-figures">{figures}</p>}
  </figure>
</div>
