---
/**
 * About teaser, as a dark door to /about (cream is proof-only since the
 * 2026-07-11 delta — the teaser is a route, not evidence, so it sits on the
 * dark ground with the same door grammar as the service rows). Stance-led:
 * p1 is what Alan is thinking about; p2 is a compact bridge to the longer
 * story (where burningsuit comes from + the responsibility talk). The
 * software-delivery credential lands once, in the home hero sig; /about
 * carries the full version, so the teaser doesn't pre-quote it.
 *
 * The whole teaser IS the door — the one tell, the `.go` label
 * `the longer story ▸`, warms to amber and nudges right. The portrait keeps
 * its carved frame and stays the minority column — this is a teaser, not the
 * about page. Copy signed 2026-06-17; the MA mention was dropped from the
 * longer-story line per Alan's about-page sign-off.
 */
import { Picture } from "astro:assets";
import about from "../assets/photos/DSC08683-Edit.jpg";

const longerStoryHref = "/about/";
---
<section class="about" id="about" aria-labelledby="who">
  <div class="wrap">
    <a class="about-door" href={longerStoryHref}>
      <div class="about-grid">
        <figure data-reveal>
          <Picture
            src={about}
            alt="Alan outdoors among trees, smiling, looking off-camera"
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[400, 600, 800]}
            sizes="(min-width: 56rem) 38vw, 100vw"
            quality={66}
            loading="lazy"
          />
        </figure>
        <div>
          <h2 id="who" class="stagger-1" data-reveal>who you'd be working <em>with</em>.</h2>
          <p class="stagger-2" data-reveal>
            These days burningsuit is me - Alan. I'll go as deep into a model as
            anyone, and I'm happy to be the one who does, so your team can stay on the
            actual job. But the depth was never the point. What I keep coming back to is
            the people using these tools: what they still need to understand, own and
            verify when AI does more of the building, so the work stays theirs.
          </p>
          <p class="stagger-3" data-reveal>
            There's more behind it - where burningsuit came from, and a talk I give
            about being responsible for work you've handed off.
          </p>
          <span class="go stagger-4" data-reveal>the longer story</span>
        </div>
      </div>
    </a>
  </div>
</section>
