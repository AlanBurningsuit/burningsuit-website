---
/**
 * About teaser, as a dark door to /about (cream is proof-only since the
 * 2026-07-11 delta — the teaser is a route, not evidence, so it sits on the
 * dark ground with the same door grammar as the service rows). The concise
 * introduction follows the homepage's working explanation and photographs.
 *
 * The whole teaser IS the door — the one tell, the `.go` label
 * `A little more about me`, warms to amber and nudges right. The portrait keeps
 * its carved frame and stays the minority column — this is a teaser, not the
 * about page. The fuller family story and responsibility talk live on /about.
 */
import { Picture } from "astro:assets";
import about from "../assets/photos/DSC08683-Edit.jpg";

const longerStoryHref = "/about/";
---
<section class="about" id="about" aria-labelledby="who">
  <div class="wrap">
    <a class="about-door" href={longerStoryHref}>
      <div class="about-grid">
        <figure data-reveal>
          <Picture
            src={about}
            alt="Alan outdoors among trees, smiling, looking off-camera"
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[400, 600, 800]}
            sizes="(min-width: 56rem) 38vw, 100vw"
            quality={66}
            loading="lazy"
          />
        </figure>
        <div>
          <h2 id="who" class="stagger-1" data-reveal>Who you'd be working <em>with</em>.</h2>
          <p class="stagger-2" data-reveal>
            I'll go as deep into a model as anyone, but I'm most interested in helping the people who have to live with it.
          </p>
          <span class="go stagger-3" data-reveal>A little more about me</span>
        </div>
      </div>
    </a>
  </div>
</section>
