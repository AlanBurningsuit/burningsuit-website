---
/**
 * About teaser, as a carved cream panel on the dark green ground (cream is
 * always a contained "entry" panel in this skin, never a full-bleed ground).
 * Stance-led: p1 is what Alan is thinking about; p2 is a compact credibility beat
 * (serious software delivery + Power BI/Fabric depth + the responsibility talk),
 * aimed at the buyer's "can I trust this person?" question — the family-business
 * genealogy lives on /about, and the link carries "the longer story". No journal
 * tab — Alan found the "the thread" label too on-the-nose; the panel stands alone.
 *
 * "the longer story" links to /about (signed + shipped 2026-06-17). The MA
 * mention was dropped from the longer-story line per Alan's about-page sign-off.
 */
import { Picture } from "astro:assets";
import about from "../assets/photos/DSC09290-Edit.jpg";

const longerStoryHref = "/about/";
---
<section class="about" id="about" aria-labelledby="who">
  <div class="wrap">
    <div class="panel">
      <div class="body about-grid">
        <figure data-reveal>
          <Picture
            src={about}
            alt="Alan on a stone bench, leaning forward, laughing at something off-camera"
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[400, 600, 800]}
            sizes="(min-width: 52rem) 45vw, 100vw"
            quality={66}
            loading="lazy"
          />
        </figure>
        <div>
          <h2 id="who" class="stagger-1" data-reveal>what i'm <em>thinking</em> about.</h2>
          <p class="stagger-2" data-reveal>
            Most of what's written about AI at work is about how to use the tools, how to
            go faster, how to get more done. I'm interested in what happens to the people
            using them. What do they still need to understand, own, and verify when AI
            does more? That question runs through everything I do now.
          </p>
          <p class="stagger-3" data-reveal>
            I spent a decade building software — large systems, some of it for
            government — before going deep on Power BI and Fabric. I also give a talk
            called "we're all middle management now", about being responsible for work
            you've handed off.
          </p>
          <a class="u stagger-4" href={longerStoryHref} data-reveal>the longer story ↗</a>
        </div>
      </div>
    </div>
  </div>
</section>
