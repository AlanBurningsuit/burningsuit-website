---
/**
 * One offer, as a carved cream panel that is itself the link (the green
 * instrument's "entry" plate). On hover/focus the card lifts toward the cursor,
 * its hard shadow deepens, and the one quiet tell — the `cta` label, e.g.
 * `see how it works ▸` — warms to the magenta spark and nudges right. The label
 * names the destination rather than the old vague "look at this" (Phase A). The
 * .panel / .tab / .go styling lives in app.css.
 */
export interface RowData {
  href: string;
  /** Journal-plate label, e.g. "offer i". Omit for a plain panel. */
  tab?: string;
  title: { before?: string; em?: string; after?: string };
  body: string;
  /** The quiet tell / affordance label. Names the action rather than the vague
   *  "look at this"; defaults to "see how it works". */
  cta?: string;
}
interface Props extends RowData {
  /** Reveal-stagger index within the grid. */
  index?: number;
}
const { href, tab, title, body, cta = "see how it works", index = 0 } = Astro.props;
---
<a class:list={["panel", `stagger-${index}`]} href={href} data-reveal>
  {
    tab && (
      <span class="tab">
        <span class="sp" aria-hidden="true" />
        {tab}
      </span>
    )
  }
  <div class="body">
    <h3>{title.before}{title.em && <em>{title.em}</em>}{title.after}</h3>
    <p>{body}</p>
    <span class="go">{cta}</span>
  </div>
</a>
