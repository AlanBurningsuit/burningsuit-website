---
/**
 * One parallel sub-point inside a chapter — the `.offer` block reused from
 * /power-bi's "what i do". A display-weight h3 title over a paragraph or two.
 * Use for the "what the team did / what I built" beats that list three or four
 * concrete things side by side. `lead` adds the quiet amber spine (`.offer-lead`)
 * to mark the primary one.
 *
 *   <Offer title="they ran their own diagnostics">
 *   When a year-to-date number looked wrong, I didn't go and fix it…
 *   </Offer>
 */
interface Props {
  title: string;
  /** Mark this as the lead item (amber spine). */
  lead?: boolean;
  /** Optional mono metadata row under the title (shape · commitment · price) —
   *  only facts already stated in the offer's own signed copy. Renders nothing
   *  when absent, so study usages are untouched. Styled by `.offer-table`
   *  contexts (/power-bi "what i do"). */
  meta?: string;
}
const { title, lead = false, meta } = Astro.props;
---

<div class:list={["offer", lead && "offer-lead"]} data-reveal>
  <h3>{title}</h3>
  {meta && <p class="offer-meta">{meta}</p>}
  <slot />
</div>
