---
/**
 * Photo as material: one candid, framed like an entry in the log. The .ph is a
 * cream-matted carved frame (border + paper-edge ring + hard shadow); a
 * clip-path curtain reveals it on scroll (kept from v2, gated off under reduced
 * motion in app.css). The old grayscale / mix-blend grade is dropped — the
 * green skin shows the photo in honest colour. Captioned since 2026-07-20
 * (Alan reversed the earlier no-captions call): the .ph-note is the log-entry
 * line — mono metadata, never commentary. astro:assets emits AVIF/WebP; no
 * inline style, so style-src 'self' holds — object-fit/position in app.css.
 */
import { Picture } from "astro:assets";
import material from "../assets/photos/DSC09119-2-Edit-Edit.jpg";
---
<section class="photo-ch">
  <div class="wrap">
    <figure data-reveal-fig>
      <div class="ph">
        <Picture
          src={material}
          alt="Alan writing at a café table outdoors, coffee beside him"
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[768, 1280, 1600]}
          sizes="(min-width: 84rem) 1312px, 100vw"
          quality={52}
          loading="lazy"
        />
      </div>
      <figcaption class="ph-note">the office, some days</figcaption>
    </figure>
  </div>
</section>
