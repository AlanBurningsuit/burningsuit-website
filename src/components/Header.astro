---
/**
 * Sticky header. Hides on scroll-down, returns on scroll-up (enhance.ts adds
 * `.hh`). Nav links only the pages that actually ship this pass — ai-fit and
 * power-bi. /about + /contact are not emitted yet; the footer mailto is the
 * contact path. The drawn underline (.u) and instant-flip CTA live in app.css.
 */
const nav = [
  { href: "/ai-fit-for-teams/", label: "ai fit for teams" },
  { href: "/power-bi/", label: "power bi" },
];
---
<header id="hd">
  <div class="wrap bar">
    <a href="/"
      ><img
        src="/logos/burningsuit-white.svg"
        alt="burningsuit — home"
        width="285"
        height="52"
      /></a
    >
    <nav aria-label="Main">
      {nav.map((n) => <a class="u" href={n.href}>{n.label}</a>)}
      <a class="cta" href="mailto:alan@burningsuit.co.uk">email me</a>
    </nav>
  </div>
</header>
