---
/**
 * Sticky header, hiding down and returning up, with a keyboard focus escape.
 * It stays visible under reduced motion. Nav links the
 * main pages — /training first, then consultancy (/power-bi, whose URL stays
 * stable for links and redirects), /work and /about. The hour and essay
 * have contextual text links. The two contact paths (booking + email) also
 * live in the footer close. The drawn
 * underline (.u) and instant-flip CTA live in app.css. The header's one action is
 * "Book an hour" CTA.
 */
import { bookingHref } from "../config/site";
// Short sentence-case labels; URLs stay stable for links and attribution.
const nav = [
  { href: "/training/", label: "Training" },
  { href: "/power-bi/", label: "Consultancy" },
  // "Work", not "Case studies": with Training and Consultancy, four labels
  // must still share one row at 320px (the header's --header-h budget).
  { href: "/work/", label: "Work" },
  { href: "/about/", label: "About" },
];
// aria-current wayfinding — server-rendered per page, zero runtime cost.
// Trailing-slash-normalised so dev-server paths match the built /page/ form.
// Exact match → "page"; ancestor match (e.g. /work over /work/law-firm/) →
// "true", so section membership stays visible on child routes.
const here = Astro.url.pathname.replace(/\/+$/, "");
const currentFor = (href: string): "page" | "true" | undefined => {
  const target = href.replace(/\/+$/, "");
  if (here === target) return "page";
  if (target && here.startsWith(`${target}/`)) return "true";
  return undefined;
};
---
<header id="hd">
  <div class="wrap bar">
    <a href="/"
      ><img
        src="/logos/burningsuit-on-green.svg"
        alt="burningsuit - home"
        width="285"
        height="52"
      /></a
    >
    <nav aria-label="Main">
      {nav.map((n) => (
        <a class="u" href={n.href} aria-current={currentFor(n.href)}>{n.label}</a>
      ))}
    </nav>
    <a class="cta" href={bookingHref("header")} target="_blank" rel="noopener noreferrer">Book an hour</a>
  </div>
</header>
