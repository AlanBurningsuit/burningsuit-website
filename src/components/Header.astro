---
/**
 * Sticky header. Hides on scroll-down, returns on scroll-up (enhance.ts adds
 * `.hh`). Nav links the pages that ship — power-bi (the front door) first, the
 * ai-fit bridge, then /work (the proof) and /about. /contact is not emitted; the
 * mailto is the contact path. The drawn underline (.u) and instant-flip CTA
 * live in app.css. `mailtoHref` carries the page's prefilled subject (built in
 * BaseLayout); defaults to a bare mailto.
 */
import { bookingHref } from "../config/site";
interface Props {
  mailtoHref?: string;
}
const nav = [
  { href: "/power-bi/", label: "power bi & fabric" },
  { href: "/ai-fit-for-teams/", label: "ai fit for teams" },
  { href: "/work/", label: "work" },
  { href: "/about/", label: "about" },
];
---
<header id="hd">
  <div class="wrap bar">
    <a href="/"
      ><img
        src="/logos/burningsuit-on-green.svg"
        alt="burningsuit — home"
        width="285"
        height="52"
      /></a
    >
    <nav aria-label="Main">
      {nav.map((n) => <a class="u" href={n.href}>{n.label}</a>)}
    </nav>
    <a class="cta" href={bookingHref("header")} target="_blank" rel="noopener noreferrer">book a call</a>
  </div>
</header>
