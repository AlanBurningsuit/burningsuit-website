---
/**
 * The service-rows instrument: rows separated by self-drawing hairlines. There
 * is one rule above, between, and below the rows (rows.length + 1), each with a
 * staggered draw-in. The :has() dim / magenta flood / arrow-swap live in
 * app.css; this component is just the structure.
 */
import ServiceRow from "./ServiceRow.astro";
import type { RowData } from "./ServiceRow.astro";

interface Props {
  rows: RowData[];
}
const { rows } = Astro.props;
---
<div class="rows">
  {
    rows.map((row, i) => (
      <>
        <hr class:list={["rule", `stagger-${i}`]} data-reveal-raw />
        <ServiceRow {...row} />
      </>
    ))
  }
  <hr class:list={["rule", `stagger-${rows.length}`]} data-reveal-raw />
</div>
