---
/**
 * The offers grid: carved cream panels, two-up on desktop and equal height
 * (no clever stagger — that read as broken), stacked on mobile. A single offer
 * ("the other thing i do" door on a service page) gets the `.single`
 * full-width treatment. The panel/lift/hover behaviour lives in app.css; this
 * component is just the structure.
 */
import ServiceRow from "./ServiceRow.astro";
import type { RowData } from "./ServiceRow.astro";

interface Props {
  rows: RowData[];
}
const { rows } = Astro.props;
---
<div class:list={["offers", rows.length === 1 ? "single" : null]}>
  {rows.map((row, i) => <ServiceRow {...row} index={i} />)}
</div>
