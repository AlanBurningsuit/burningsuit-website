---
/**
 * The proof-tile grid (/work): carved cream panels, two-up on desktop and
 * equal height (no clever stagger — that read as broken), stacked on mobile.
 * Cream is proof-only, so this renders case-file tiles; routes into the
 * service pages are DoorRow (dark). The panel/lift/hover behaviour lives in
 * app.css; this component is just the structure.
 */
import ServiceRow from "./ServiceRow.astro";
import type { RowData } from "./ServiceRow.astro";

interface Props {
  rows: RowData[];
}
const { rows } = Astro.props;
---
<div class="offers">
  {rows.map((row, i) => <ServiceRow {...row} index={i} />)}
</div>
