---
/**
 * The "how i work" chapter, in the green-instrument idiom: the logbook spine
 * (a sticky mono section label in the left margin, the content on the right).
 * The content is the three parallel principles as an unnumbered, hairline-
 * separated list. The old magenta ground-morph + big chapter headline are
 * retired — the page holds one warm ground throughout, and these principles
 * are parallel, so they get no numerals (see Principle.astro).
 */
import Principle from "./Principle.astro";

interface Props {
  kicker: string;
  headingId: string;
  principles: { title: string; body: string }[];
}
const { kicker, headingId, principles } = Astro.props;
---
<section class="chapter" aria-labelledby={headingId}>
  <div class="wrap what">
    <div class="label">
      <h2 class="kicker meta" id={headingId} data-reveal>{kicker}</h2>
    </div>
    <div class="principles">
      {principles.map((p) => <Principle title={p.title} body={p.body} />)}
    </div>
  </div>
</section>
