---
/**
 * The "how i work" chapter: a plain chapter with its one signed string as
 * the display section head, over the three parallel principles as an
 * unnumbered, hairline-separated list. Parallel means no numerals
 * (see Principle.astro).
 */
import Principle from "./Principle.astro";

interface Props {
  kicker: string;
  headingId: string;
  principles: { title: string; body: string }[];
}
const { kicker, headingId, principles } = Astro.props;
---
<section class="chapter" aria-labelledby={headingId}>
  <div class="wrap">
    <h2 class="section-head" id={headingId} data-reveal>{kicker}</h2>
    <div class="principles">
      {principles.map((p) => <Principle title={p.title} body={p.body} />)}
    </div>
  </div>
</section>
