---
/**
 * The recorded hand's one survivor (D9, final shape 2026-07-14): Alan's real
 * signature, captured once on the SLS2 pen and exported through the
 * handwriting pipeline (ops design/handwriting/, raw bundle slug "alan";
 * animation classes + pathLength stripped - static ink, never animated,
 * never a handwriting font). Two homes only: the footer signoff and the
 * close of /about. Scarcity is the device - don't add a third.
 */
interface Props {
  /** Adds data-reveal so the chapter reveal rhythm applies (used on /about). */
  reveal?: boolean;
}
const { reveal = false } = Astro.props;
---
<svg
  class="signoff"
  viewBox="0 0 31 16"
  width="31"
  height="16"
  role="img"
  aria-label="Alan"
  xmlns="http://www.w3.org/2000/svg"
  data-reveal={reveal || undefined}
>
  <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    <path d="M1.5 4.9q0 7.3 0 3 0-4.4 .3-5.4 .3-1 1 .2 .7 1.2 3.6 11.3"/>
    <path d="M2.3 10.3l5.3-2.9"/>
    <path d="M8.5 7q-1.1 3.6-.7 4.6 .3 .9 1 1.1 .6 .1 1.2-.3 .5-.4 1.4-2.9 .8-2.5 1.6 0 .8 2.5 .8-.1-.1-2.6 .1-3.5 .1-.9 .4-1 .3-.2 1.5 1.7 1.1 1.8 2.5 6.6"/>
    <path d="M14 10.6q5.3-3.6 5.5-1.1 .1 2.4-.5 0-.6-2.5 1.9-.3 2.5 2.2 4.1 2.2 1.6 0 2.8-1.1 1.1-1.2 .8-5.8"/>
  </g>
</svg>
